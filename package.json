{
  "name": "AionUi",
  "version": "2.2.2",
  "description": "Self-hosted Codex WebUI for Unraid and local browser development.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "AionUi",
    "email": "service@aionui.com"
  },
  "workspaces": [
    "packages/web-host"
  ],
  "scripts": {
    "dev": "bun run webui",
    "start": "bun run webui",
    "start:multi": "AIONUI_MULTI_INSTANCE=1 bun run webui",
    "webui": "bun scripts/webui.ts",
    "webui:remote": "bun scripts/webui.ts --remote",
    "webui:prod": "NODE_ENV=production bun scripts/webui.ts",
    "webui:prod:remote": "NODE_ENV=production bun scripts/webui.ts --remote",
    "resetpass": "bun scripts/resetpass.ts",
    "build": "bun run package",
    "package": "bun run web:runtime:build && bun run openui:check && vite build --config packages/desktop/vite.webui.config.ts",
    "codex": "codex",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "openui:core:build": "bun packages/web-host/openui/core/build.ts",
    "openui:core:test": "bun packages/web-host/openui/core/build.ts --test",
    "openui:qa": "tsx packages/web-host/openui/qa/browser.ts",
    "web:runtime:build": "bun packages/web-host/src/runtime/codex/build.ts",
    "test": "bun run web:runtime:build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config playwright.config.ts",
    "prepare": "husky",
    "openui:generate": "bun packages/web-host/openui/generate.ts",
    "openui:check": "bun packages/web-host/openui/generate.ts --check"
  },
  "dependencies": {
    "@aionui/web-host": "workspace:*",
    "@openai/codex": "0.163.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@arco-design/web-react": "^2.66.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.38.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.16",
    "@google/genai": "^1.16.0",
    "@icon-park/react": "^1.4.2",
    "@iconify/react": "^6.0.2",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.2",
    "@vitest/coverage-v8": "^4.0.18",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.18",
    "diff": "^8.0.3",
    "diff2html": "^3.4.55",
    "docx": "^9.5.1",
    "eventemitter3": "^5.0.1",
    "https-proxy-agent": "^7.0.6",
    "husky": "^9.1.7",
    "i18next": "^23.7.16",
    "jsdom": "^28.1.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.13.0",
    "katex": "^0.16.22",
    "lint-staged": "^16.2.7",
    "mammoth": "^1.11.0",
    "mermaid": "^11.13.0",
    "openai": "^5.12.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "playwright": "1.59.1",
    "postcss": "^8.5.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^14.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.7.2",
    "streamdown": "^1.5.1",
    "swr": "^2.3.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.8.3",
    "unocss": "^66.3.3",
    "unocss-preset-extra": "^1.0.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18",
    "wavedrom": "^3.6.2",
    "ws": "^8.18.3",
    "xlsx-republish": "^0.20.3"
  },
  "resolutions": {
    "@codemirror/language": "6.12.3",
    "body-parser": "^2.2.1",
    "hono": "^4.11.7",
    "jws": "4.0.1",
    "lodash-es": "^4.17.23",
    "mdast-util-to-hast": "^13.2.1",
    "node-forge": "^1.3.2",
    "tar": "^7.5.7",
    "tmp": "^0.2.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md,yaml,yml,toml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22 <25"
  },
  "aioncoreVersion": "v0.2.2"
}
