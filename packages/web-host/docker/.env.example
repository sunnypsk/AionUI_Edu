# Copy to .env next to compose.yaml. Never commit credentials.
AIONUI_APPDATA=/mnt/user/appdata/aionui-edu/data
# Set a NAS LAN address to expose the WebUI on your LAN; default is loopback.
AIONUI_BIND_ADDRESS=127.0.0.1
AIONUI_PORT=25808
PUID=99
PGID=100
# Leave empty to configure SOCKS5 in Settings. For an environment-managed proxy:
# AIONUI_SOCKS5_PROXY=socks5://192.168.1.10:1080
# URL-encode username/password if authentication is required.
