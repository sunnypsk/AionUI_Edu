+use std::{collections::HashMap, io, time::Duration};
+
+use futures_util::StreamExt;
+use mcp_reqwest::{
+    Client,
+    header::{HeaderMap, HeaderName, HeaderValue},
+};
+use rmcp::{
+    RoleClient,
+    service::{RxJsonRpcMessage, TxJsonRpcMessage},
+    transport::Transport,
+};
+use tokio::{sync::mpsc, task::JoinHandle};
+
+/// Compatibility transport for configured pre-Streamable-HTTP MCP servers.
+pub(super) struct LegacySse {
+    client: Client,
+    endpoint: url::Url,
+    headers: HeaderMap,
+    receiver: mpsc::Receiver<RxJsonRpcMessage<RoleClient>>,
+    listener: JoinHandle<()>,
+}
+
+fn invalid(code: &str) -> io::Error {
+    io::Error::other(code)
+}
+
+impl LegacySse {
+    pub fn cancellation(&self) -> super::http_client::HttpCancellation {
+        super::http_client::HttpCancellation::legacy(self.client.clone(), self.endpoint.as_str(), &self.headers)
+    }
+
+    pub async fn connect(client: Client, uri: &str, values: &HashMap<String, String>) -> io::Result<Self> {
+        let origin = url::Url::parse(uri).map_err(|_| invalid("MCP_INVALID_URL"))?;
+        let mut headers = HeaderMap::new();
+        for (key, value) in values {
+            headers.insert(
+                HeaderName::from_bytes(key.as_bytes()).map_err(|_| invalid("MCP_INVALID_HEADER"))?,
+                HeaderValue::from_str(value).map_err(|_| invalid("MCP_INVALID_HEADER"))?,
+            );
+        }
+        let response = client
+            .get(uri)
+            .headers(headers.clone())
+            .header("Accept", "text/event-stream")
+            .send()
+            .await
+            .map_err(|_| invalid("MCP_SSE_CONNECT_FAILED"))?;
+        if !response.status().is_success() {
+            return Err(invalid("MCP_SSE_HTTP_ERROR"));
+        }
+        let mut events = Box::pin(sse_stream::SseStream::from_bytes_stream(response.bytes_stream()));
+        let endpoint = loop {
+            let event = events
+                .next()
+                .await
+                .ok_or_else(|| invalid("MCP_SSE_ENDPOINT_MISSING"))?
+                .map_err(|_| invalid("MCP_SSE_INVALID_EVENT"))?;
+            if event.event.as_deref() == Some("endpoint") {
+                let value = event.data.ok_or_else(|| invalid("MCP_SSE_ENDPOINT_MISSING"))?;
+                let endpoint = origin.join(&value).map_err(|_| invalid("MCP_INVALID_URL"))?;
+                // Configured credentials must never be forwarded to a different server.
+                if origin.origin() != endpoint.origin() {
+                    return Err(invalid("MCP_SSE_CROSS_ORIGIN_ENDPOINT"));
+                }
+                break endpoint;
+            }
+        };
+        let (sender, receiver) = mpsc::channel(64);
+        let listener = tokio::spawn(async move {
+            while let Some(Ok(event)) = events.next().await {
+                if event.event.as_deref().is_some_and(|kind| kind != "message") {
+                    continue;
+                }
+                let Some(data) = event.data else {
+                    continue;
+                };
+                let Ok(message) = serde_json::from_str(&data) else {
+                    break;
+                };
+                if sender.send(message).await.is_err() {
+                    break;
+                }
+            }
+        });
+        Ok(Self {
+            client,
+            endpoint,
+            headers,
+            receiver,
+            listener,
+        })
+    }
+}
+
+impl Transport<RoleClient> for LegacySse {
+    type Error = io::Error;
+
+    fn send(&mut self, item: TxJsonRpcMessage<RoleClient>) -> impl Future<Output = io::Result<()>> + Send + 'static {
+        let client = self.client.clone();
+        let endpoint = self.endpoint.clone();
+        let headers = self.headers.clone();
+        async move {
+            let response = client
+                .post(endpoint)
+                .headers(headers)
+                .timeout(Duration::from_secs(60))
+                .json(&item)
+                .send()
+                .await
+                .map_err(|_| invalid("MCP_SSE_SEND_FAILED"))?;
+            if !response.status().is_success() {
+                return Err(invalid("MCP_SSE_HTTP_ERROR"));
+            }
+            Ok(())
+        }
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        self.receiver.recv().await
+    }
+    async fn close(&mut self) -> io::Result<()> {
+        self.listener.abort();
+        Ok(())
+    }
+}
+
+impl Drop for LegacySse {
+    fn drop(&mut self) {
+        self.listener.abort();
+    }
+}
