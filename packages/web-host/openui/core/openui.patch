+use std::sync::Arc;
+
+use aionui_conversation::{ConversationError, OpenUiService};
+use aionui_db::{
+    IClientPreferenceRepository, IConversationRepository, OpenUiStateKey, SqliteClientPreferenceRepository,
+    SqliteConversationRepository, SqliteOpenUiRepository, init_database_memory, models::MessageRow,
+};
+
+const USER: &str = "system_default_user";
+
+async fn service(content: &str) -> (OpenUiService, OpenUiStateKey, Arc<SqliteClientPreferenceRepository>) {
+    let db = init_database_memory().await.unwrap();
+    sqlx::query("INSERT INTO conversations (id,user_id,name,type,extra,created_at,updated_at) VALUES ('conversation',?,'OpenUI','acp','{}',1,1)")
+        .bind(USER).execute(db.pool()).await.unwrap();
+    let conversations = Arc::new(SqliteConversationRepository::new(db.pool().clone()));
+    conversations
+        .insert_message(
+            USER,
+            &MessageRow {
+                id: "message".into(),
+                conversation_id: "conversation".into(),
+                msg_id: Some("source-message".into()),
+                r#type: "text".into(),
+                content: serde_json::json!({ "content": content }).to_string(),
+                position: Some("left".into()),
+                status: Some("finish".into()),
+                hidden: false,
+                created_at: 1,
+                backend_turn_id: None,
+            },
+        )
+        .await
+        .unwrap();
+    let preferences = Arc::new(SqliteClientPreferenceRepository::new(db.pool().clone()));
+    let state = OpenUiService::new(
+        Arc::new(SqliteOpenUiRepository::new(db.pool().clone())),
+        conversations,
+        preferences.clone(),
+    );
+    let key = OpenUiStateKey {
+        user_id: USER.into(),
+        conversation_id: "conversation".into(),
+        message_id: "message".into(),
+        block_id: "0".into(),
+    };
+    (state, key, preferences)
+}
+
+#[tokio::test]
+async fn state_round_trips_with_a_server_derived_program_identity() {
+    let (service, key, _) = service("```openui\nroot = Text(\"Hello\")\n```").await;
+    let mut snapshot = service.read_state(&key).await.unwrap();
+    assert_eq!(snapshot.library_id, "openui");
+    assert_eq!(snapshot.library_version, "0.18.1");
+    snapshot.state.insert("name".into(), serde_json::json!("Ada"));
+    let saved = service.write_state(&key, snapshot).await.unwrap();
+    assert_eq!(saved.revision, 1);
+    assert_eq!(service.read_state(&key).await.unwrap().state["name"], "Ada");
+}
+
+#[tokio::test]
+async fn client_supplied_program_hashes_cannot_rebind_a_snapshot() {
+    let (service, key, _) = service("root = Text(\"Hello\")").await;
+    let mut snapshot = service.read_state(&key).await.unwrap();
+    snapshot.program_hash = "caller-authored-hash".into();
+    let result = service.write_state(&key, snapshot).await;
+    assert!(matches!(result, Err(ConversationError::Busy { reason }) if reason == "OPENUI_PROGRAM_VERSION_CONFLICT"));
+}
+
+#[tokio::test]
+async fn chat_blocks_keep_their_separate_library_identity() {
+    let (service, mut key, _) = service("```openui\nroot = Stack([])\n```\n```openui-chat\nroot = Card([])\n```").await;
+    key.block_id = "1".into();
+    assert_eq!(service.read_state(&key).await.unwrap().library_id, "openui-chat");
+}
+
+#[tokio::test]
+async fn another_account_cannot_read_an_owned_assistant_block() {
+    let (service, mut key, _) = service("root = Text(\"Hello\")").await;
+    key.user_id = "other".into();
+    assert!(matches!(
+        service.read_state(&key).await,
+        Err(ConversationError::MessageNotFound { .. })
+    ));
+}
+
+#[tokio::test]
+async fn block_ids_are_canonical_and_must_exist() {
+    let (service, mut key, _) = service("root = Text(\"Hello\")").await;
+    for invalid in ["00", "-1", "999999999999999999999999999999999999999"] {
+        key.block_id = invalid.into();
+        assert!(
+            matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_INVALID_BLOCK_ID")
+        );
+    }
+    key.block_id = "1".into();
+    assert!(
+        matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_BLOCK_NOT_FOUND")
+    );
+}
+
+#[tokio::test]
+async fn an_unclosed_program_does_not_enable_state_writes() {
+    let (service, key, _) = service("```openui\nroot = Stack([").await;
+    assert!(
+        matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_INCOMPLETE_BLOCK")
+    );
+}
+
+#[tokio::test]
+async fn a_stale_device_receives_a_revision_conflict() {
+    let (service, key, _) = service("root = Text(\"Hello\")").await;
+    let stale = service.read_state(&key).await.unwrap();
+    service.write_state(&key, stale.clone()).await.unwrap();
+    assert!(
+        matches!(service.write_state(&key, stale).await, Err(ConversationError::Busy { reason }) if reason == "OPENUI_STATE_REVISION_CONFLICT")
+    );
+}
+
+#[tokio::test]
+async fn disabling_generation_preserves_historical_interaction_state() {
+    let (service, key, preferences) = service("root = Text(\"Hello\")").await;
+    assert!(service.generation_enabled(USER).await.unwrap());
+    preferences
+        .upsert_batch(USER, &[("openuiEnabled", "false")])
+        .await
+        .unwrap();
+    assert!(!service.generation_enabled(USER).await.unwrap());
+    assert_eq!(service.read_state(&key).await.unwrap().revision, 0);
+}
+
+#[tokio::test]
+async fn negative_revisions_and_oversized_state_are_rejected() {
+    let (service, key, _) = service("root = Text(\"Hello\")").await;
+    let mut invalid = service.read_state(&key).await.unwrap();
+    invalid.revision = -1;
+    assert!(
+        matches!(service.write_state(&key, invalid).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_INVALID_REVISION")
+    );
+    let mut large = service.read_state(&key).await.unwrap();
+    large
+        .state
+        .insert("text".into(), serde_json::json!("x".repeat(2 * 1024 * 1024)));
+    assert!(
+        matches!(service.write_state(&key, large).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_STATE_TOO_LARGE")
+    );
+}
