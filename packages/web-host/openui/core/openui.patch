+mod resource_tests {
+    use super::*;
+
+    #[test]
+    fn local_resource_failures_are_manual_retry_only_and_redacted() {
+        for detail in [
+            "spawn '/private/agent' failed: Resource temporarily unavailable (os error 11)",
+            "CODEX_RESOURCES_UNAVAILABLE token=private",
+            "agent process exited before initialize handshake completed: AGENT_RESOURCES_UNAVAILABLE",
+            "failed to initialize sqlite state runtime: Resource temporarily unavailable (os error 11)",
+            "thread-store: error communicating with database: Resource temporarily unavailable (os error 11)",
+            "failed to spawn thread: Os { code: 11, kind: WouldBlock, message: Resource temporarily unavailable }",
+        ] {
+            let error = classify_upstream_detail(detail).into_stream_error();
+            assert_eq!(error.code, Some(AgentErrorCode::AgentResourcesUnavailable), "{detail}");
+            assert_eq!(error.ownership, Some(AgentErrorOwnership::Aionui));
+            assert_eq!(error.detail.as_deref(), Some("AGENT_RESOURCES_UNAVAILABLE"));
+            assert_eq!(error.retryable, Some(true));
+        }
+    }
+
+    #[test]
+    fn typed_process_errors_classify_resources_before_generic_lifecycle_codes() {
+        for error in [
+            AcpError::SpawnFailed {
+                message: "spawn /private/agent: Resource temporarily unavailable (os error 11)".into(),
+            },
+            AcpError::StartupCrash {
+                exit_code: Some(1),
+                signal: None,
+                stderr: "CODEX_RESOURCES_UNAVAILABLE private=payload".into(),
+            },
+            AcpError::Disconnected {
+                exit_code: Some(1),
+                signal: None,
+                stderr: "AGENT_RESOURCES_UNAVAILABLE".into(),
+            },
+        ] {
+            let error = AgentSendError::from_agent_error(AgentError::Acp(error)).into_stream_error();
+            assert_eq!(error.code, Some(AgentErrorCode::AgentResourcesUnavailable));
+            assert_eq!(error.ownership, Some(AgentErrorOwnership::Aionui));
+            assert_eq!(error.detail.as_deref(), Some("AGENT_RESOURCES_UNAVAILABLE"));
+            assert!(!error.message.contains("private"));
+        }
+        let network_error = AgentSendError::from_agent_error(AgentError::Acp(AcpError::Disconnected {
+            exit_code: Some(1),
+            signal: None,
+            stderr: "socket read: Resource temporarily unavailable".into(),
+        }))
+        .into_stream_error();
+        assert_eq!(network_error.code, Some(AgentErrorCode::UserAgentDisconnected));
+        assert!(!network_error.detail.unwrap_or_default().contains("socket"));
+    }
+
+    #[test]
+    fn network_would_block_is_not_local_resource_exhaustion() {
+        assert!(!aionui_session::is_local_resource_exhaustion(
+            "network read: WouldBlock"
+        ));
+        assert!(!aionui_session::is_local_resource_exhaustion(
+            "socket read: Resource temporarily unavailable"
+        ));
+    }
+}
