+use std::sync::Arc;
+
+use aionui_api_types::{OpenUiTool, OpenUiToolCall, OpenUiToolMode, SessionMcpServer};
+use aionui_db::{OpenUiOperationClaim, OpenUiStateKey};
+use aionui_mcp::McpExecutionService;
+use aionui_realtime::EventBroadcaster;
+use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+use crate::{ConversationError, ConversationService};
+
+use super::{OpenUiService, operations::ActiveOperations, permissions::OpenUiPermissions};
+
+pub(crate) struct OpenUiSnapshot {
+    pub servers: Vec<SessionMcpServer>,
+}
+
+pub(super) struct OpenUiRuntime {
+    pub execution: McpExecutionService,
+    pub permissions: OpenUiPermissions,
+    pub operations: ActiveOperations,
+}
+
+impl OpenUiRuntime {
+    pub fn new(execution: McpExecutionService, broadcaster: Arc<dyn EventBroadcaster>) -> Self {
+        Self {
+            execution,
+            permissions: OpenUiPermissions::new(broadcaster),
+            operations: ActiveOperations::default(),
+        }
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+enum RecordedOutcome {
+    Success { result: Value },
+    Failed { kind: String, code: String },
+}
+
+fn key(server: &str, name: &str) -> String {
+    format!(
+        "mcp.{}.{}",
+        URL_SAFE_NO_PAD.encode(server),
+        URL_SAFE_NO_PAD.encode(name)
+    )
+}
+
+fn parse_key(key: &str) -> Result<(String, String), ConversationError> {
+    let parts: Vec<_> = key.split('.').collect();
+    let bad = || ConversationError::BadRequest {
+        reason: "OPENUI_INVALID_TOOL_KEY".into(),
+    };
+    if parts.len() != 3 || parts[0] != "mcp" {
+        return Err(bad());
+    }
+    let server = String::from_utf8(URL_SAFE_NO_PAD.decode(parts[1]).map_err(|_| bad())?).map_err(|_| bad())?;
+    let name = String::from_utf8(URL_SAFE_NO_PAD.decode(parts[2]).map_err(|_| bad())?).map_err(|_| bad())?;
+    if server.is_empty() || name.is_empty() {
+        return Err(bad());
+    }
+    Ok((server, name))
+}
+
+fn fingerprint(value: &impl Serialize) -> Result<String, ConversationError> {
+    let mut value =
+        serde_json::to_value(value).map_err(|_| ConversationError::internal("OPENUI_SERIALIZATION_FAILED"))?;
+    value.sort_all_objects();
+    Ok(format!("{:x}", Sha256::digest(value.to_string().as_bytes())))
+}
+
+impl OpenUiService {
+    pub(crate) async fn tools(
+        &self,
+        conversation: &ConversationService,
+        user: &str,
+        id: &str,
+    ) -> Result<Vec<OpenUiTool>, ConversationError> {
+        let snapshot = conversation.openui_snapshot(user, id).await?;
+        let runtime = self.runtime.as_ref().ok_or_else(unavailable)?;
+        runtime.execution.retain_snapshot(user, id, &snapshot.servers).await;
+        let mut output = Vec::new();
+        for server in &snapshot.servers {
+            match runtime.execution.tools(user, id, server).await {
+                Ok(tools) => output.extend(tools.into_iter().map(|tool| OpenUiTool {
+                    key: key(&server.id, &tool.name),
+                    name: tool.name,
+                    description: tool.description,
+                    input_schema: tool.input_schema,
+                    read_only: tool.read_only,
+                })),
+                Err(_) => tracing::warn!(
+                    user_id = user,
+                    conversation_id = id,
+                    server_id = server.id,
+                    "OpenUI MCP catalog unavailable"
+                ),
+            }
+        }
+        Ok(output)
+    }
+
+    pub(crate) async fn call_tool(
+        &self,
+        conversation: &ConversationService,
+        user: &str,
+        id: &str,
+        request: OpenUiToolCall,
+    ) -> Result<Value, ConversationError> {
+        let snapshot = conversation.openui_snapshot(user, id).await?;
+        let runtime = self.runtime.as_ref().ok_or_else(unavailable)?;
+        runtime.execution.retain_snapshot(user, id, &snapshot.servers).await;
+        let key = OpenUiStateKey {
+            user_id: user.into(),
+            conversation_id: id.into(),
+            message_id: request.message_id.clone(),
+            block_id: request.block_id.clone(),
+        };
+        let block = self.owned_block(&key).await?;
+        if block.hash() != request.program_hash {
+            return Err(ConversationError::Busy {
+                reason: "OPENUI_PROGRAM_VERSION_CONFLICT".into(),
+            });
+        }
+        let (server_id, name) = parse_key(&request.tool_key)?;
+        let server = snapshot
+            .servers
+            .iter()
+            .find(|server| server.id == server_id)
+            .ok_or_else(|| ConversationError::Forbidden {
+                reason: "OPENUI_TOOL_NOT_ENABLED".into(),
+            })?;
+        let mutation = request.mode == OpenUiToolMode::Mutation;
+        let operation = match request.operation_id.as_deref() {
+            Some(value) if !value.is_empty() && value.len() <= 512 && !value.chars().any(char::is_control) => {
+                value.to_owned()
+            }
+            None if !mutation => aionui_common::generate_prefixed_id("openui-query"),
+            _ => {
+                return Err(ConversationError::BadRequest {
+                    reason: "OPENUI_INVALID_OPERATION_ID".into(),
+                });
+            }
+        };
+        let request_fingerprint = fingerprint(&json!({"request":request,"server":server}))?;
+        if mutation {
+            match self
+                .states
+                .claim_operation(&key, &operation, &request_fingerprint)
+                .await?
+            {
+                OpenUiOperationClaim::Claimed => (),
+                OpenUiOperationClaim::Pending => {
+                    return Err(ConversationError::Busy {
+                        reason: "OPENUI_OPERATION_IN_PROGRESS".into(),
+                    });
+                }
+                OpenUiOperationClaim::Replay(outcome) => {
+                    return replay(
+                        serde_json::from_str(&outcome)
+                            .map_err(|_| ConversationError::internal("OPENUI_INVALID_OPERATION_RECEIPT"))?,
+                    );
+                }
+            }
+        }
+        let outcome = async {
+            let (_active, mut cancelled) = runtime.operations.begin(user, id, &operation)?;
+            let execute = async {
+                let approval_key = fingerprint(&json!({"server":server,"name":name}))?;
+                if mutation {
+                    let (read_only, preapproved) = conversation.openui_permission_policy(user, id, &name).await?;
+                    if read_only {
+                        return Err(ConversationError::Forbidden {
+                            reason: "OPENUI_READ_ONLY_CONVERSATION".into(),
+                        });
+                    }
+                    let explicitly_confirmed = !preapproved;
+                    if explicitly_confirmed {
+                        runtime
+                            .permissions
+                            .request(
+                                user,
+                                id,
+                                &approval_key,
+                                format!("{} / {}", server.name, name),
+                                Value::Object(request.arguments.clone()),
+                            )
+                            .await?;
+                    }
+                    // Approval cannot authorize a replacement endpoint or a newly restricted conversation.
+                    let fresh = conversation.openui_snapshot(user, id).await?;
+                    if !fresh.servers.iter().any(|candidate| candidate == server) {
+                        return Err(ConversationError::Busy {
+                            reason: "OPENUI_MCP_SNAPSHOT_CHANGED".into(),
+                        });
+                    }
+                    let (read_only, still_preapproved) = conversation.openui_permission_policy(user, id, &name).await?;
+                    if read_only {
+                        return Err(ConversationError::Forbidden {
+                            reason: "OPENUI_READ_ONLY_CONVERSATION".into(),
+                        });
+                    }
+                    if !explicitly_confirmed && !still_preapproved {
+                        return Err(ConversationError::Busy {
+                            reason: "OPENUI_PERMISSION_POLICY_CHANGED".into(),
+                        });
+                    }
+                }
+                runtime
+                    .execution
+                    .call_tool(user, id, server, &name, request.arguments.clone(), !mutation)
+                    .await
+                    .map_err(mcp_error)
+            };
+            tokio::select! {
+                result = execute => result,
+                _ = cancelled.changed() => Err(ConversationError::Busy { reason: "OPENUI_OPERATION_CANCELLED".into() }),
+            }
+        }
+        .await;
+        if mutation {
+            let recorded = record(&outcome);
+            let json = serde_json::to_string(&recorded)
+                .map_err(|_| ConversationError::internal("OPENUI_SERIALIZATION_FAILED"))?;
+            self.states
+                .complete_operation(&key, &operation, &request_fingerprint, &json)
+                .await?;
+        }
+        outcome
+    }
+
+    pub(crate) fn cancel_operation(&self, user: &str, id: &str, operation: &str) {
+        if let Some(runtime) = &self.runtime {
+            runtime.operations.cancel(user, id, operation);
+        }
+    }
+}
+
+fn unavailable() -> ConversationError {
+    ConversationError::BadGateway {
+        reason: "OPENUI_RUNTIME_UNAVAILABLE".into(),
+    }
+}
+
+fn mcp_error(error: aionui_mcp::McpError) -> ConversationError {
+    let reason = match error {
+        aionui_mcp::McpError::ConnectionFailed(code) if code.starts_with("MCP_") && code.len() < 128 => code,
+        aionui_mcp::McpError::OAuth(_) => "OPENUI_MCP_OAUTH_REQUIRED".into(),
+        _ => "OPENUI_MCP_REQUEST_FAILED".into(),
+    };
+    if reason == "MCP_QUERY_REQUIRES_READ_ONLY_TOOL" || reason == "MCP_TOOL_UNAVAILABLE" {
+        ConversationError::Forbidden { reason }
+    } else {
+        ConversationError::BadGateway { reason }
+    }
+}
+
+fn record(result: &Result<Value, ConversationError>) -> RecordedOutcome {
+    match result {
+        Ok(result) => RecordedOutcome::Success { result: result.clone() },
+        Err(ConversationError::Forbidden { reason }) => RecordedOutcome::Failed {
+            kind: "forbidden".into(),
+            code: reason.clone(),
+        },
+        Err(ConversationError::Busy { reason }) => RecordedOutcome::Failed {
+            kind: "conflict".into(),
+            code: reason.clone(),
+        },
+        Err(ConversationError::BadGateway { reason }) => RecordedOutcome::Failed {
+            kind: "gateway".into(),
+            code: reason.clone(),
+        },
+        Err(_) => RecordedOutcome::Failed {
+            kind: "gateway".into(),
+            code: "OPENUI_OPERATION_FAILED".into(),
+        },
+    }
+}
+
+fn replay(recorded: RecordedOutcome) -> Result<Value, ConversationError> {
+    match recorded {
+        RecordedOutcome::Success { result } => Ok(result),
+        RecordedOutcome::Failed { kind, code } => Err(match kind.as_str() {
+            "forbidden" => ConversationError::Forbidden { reason: code },
+            "conflict" => ConversationError::Busy { reason: code },
+            _ => ConversationError::BadGateway { reason: code },
+        }),
+    }
+}
