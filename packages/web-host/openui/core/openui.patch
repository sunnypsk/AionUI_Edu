+    elif method == 'tools/list':
+        result = {'tools': [{'name': 'read', 'inputSchema': {'type': 'object'}, 'annotations': {'readOnlyHint': True}}, {'name': 'write', 'inputSchema': {'type': 'object'}}]}
+    elif method == 'tools/call':
+        count += 1
+        result = {'content': [{'type': 'text', 'text': 'ok'}], 'structuredContent': {'count': count}, 'isError': False}
