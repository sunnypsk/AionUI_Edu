+use std::sync::Arc;
+
+use aionui_ai_agent::{AgentStreamEvent, protocol::events::FinishEventData};
+use aionui_conversation::{OpenUiService, service::OPENUI_NAME_SOURCE, stream_relay::StreamRelay};
+use aionui_db::{
+    ConversationRowUpdate, IConversationRepository, SqliteClientPreferenceRepository, SqliteConversationRepository,
+    SqliteOpenUiRepository, init_database_memory,
+};
+use aionui_realtime::BroadcastEventBus;
+use tokio::sync::broadcast;
+
+const USER: &str = "system_default_user";
+const CONVERSATION: &str = "conversation";
+const USER_TITLE: &str = "可唔可以幫我睇下聽日嘅香港天氣。";
+const GUIDANCE_TITLE: &str = "OpenUI Protocol Interface Guidelines";
+
+async fn service() -> (OpenUiService, Arc<SqliteConversationRepository>, aionui_db::Database) {
+    let db = init_database_memory().await.unwrap();
+    // The renderer's `auto` title leaves `name_source` NULL (agent-overwritable).
+    sqlx::query("INSERT INTO conversations (id,user_id,name,type,extra,created_at,updated_at) VALUES (?,?,?,'acp','{}',1,1)")
+        .bind(CONVERSATION)
+        .bind(USER)
+        .bind(USER_TITLE)
+        .execute(db.pool())
+        .await
+        .unwrap();
+    let conversations = Arc::new(SqliteConversationRepository::new(db.pool().clone()));
+    let state = OpenUiService::new(
+        Arc::new(SqliteOpenUiRepository::new(db.pool().clone())),
+        conversations.clone(),
+        Arc::new(SqliteClientPreferenceRepository::new(db.pool().clone())),
+    );
+    (state, conversations, db)
+}
+
+/// Deliver an agent session title the way a live turn does.
+async fn agent_reports_title(conversations: &Arc<SqliteConversationRepository>, title: &str) {
+    let (tx, _) = broadcast::channel(16);
+    let relay = StreamRelay::new(
+        CONVERSATION.into(),
+        "assistant".into(),
+        "turn".into(),
+        USER.into(),
+        conversations.clone(),
+        Arc::new(BroadcastEventBus::new(16)),
+    );
+    let rx = tx.subscribe();
+    tx.send(AgentStreamEvent::AcpSessionInfo(serde_json::json!({ "title": title }))).unwrap();
+    tx.send(AgentStreamEvent::Finish(FinishEventData::default())).unwrap();
+    relay.consume(rx).await;
+}
+
+async fn stored_name(conversations: &Arc<SqliteConversationRepository>) -> (String, Option<String>) {
+    let row = conversations.get(USER, CONVERSATION).await.unwrap().unwrap();
+    (row.name, row.name_source)
+}
+
+#[tokio::test]
+async fn agent_title_ignored_when_openui_guidance_injected() {
+    let (service, conversations, _db) = service().await;
+    service.keep_title_from_guidance(USER, CONVERSATION).await.unwrap();
+    agent_reports_title(&conversations, GUIDANCE_TITLE).await;
+    assert_eq!(
+        stored_name(&conversations).await,
+        (USER_TITLE.to_string(), Some(OPENUI_NAME_SOURCE.to_string()))
+    );
+}
+
+#[tokio::test]
+async fn agent_title_still_applies_without_openui_guidance() {
+    let (_service, conversations, _db) = service().await;
+    agent_reports_title(&conversations, "Hong Kong weather").await;
+    assert_eq!(
+        stored_name(&conversations).await,
+        ("Hong Kong weather".to_string(), Some("agent".to_string()))
+    );
+}
+
+#[tokio::test]
+async fn guidance_keeps_an_explicit_user_rename_user_owned() {
+    let (service, conversations, _db) = service().await;
+    conversations
+        .update(
+            USER,
+            CONVERSATION,
+            &ConversationRowUpdate {
+                name: Some("天氣".into()),
+                name_source: Some("user".into()),
+                ..Default::default()
+            },
+        )
+        .await
+        .unwrap();
+    service.keep_title_from_guidance(USER, CONVERSATION).await.unwrap();
+    agent_reports_title(&conversations, GUIDANCE_TITLE).await;
+    assert_eq!(
+        stored_name(&conversations).await,
+        ("天氣".to_string(), Some("user".to_string()))
+    );
+}
