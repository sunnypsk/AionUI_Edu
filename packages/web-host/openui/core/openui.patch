+fn tool_result_images(content: &[ToolResultContent]) -> Vec<ToolImageOutput> {
+    let mut images = Vec::new();
+    for part in content {
+        if let ToolResultContent::FilePath { path, mime, .. } = part {
+            let mime = mime
+                .clone()
+                .or_else(|| mime_guess::from_path(path).first_raw().map(str::to_owned));
+            if let Some(mime_type) =
+                mime.filter(|m| matches!(m.as_str(), "image/png" | "image/jpeg" | "image/webp" | "image/gif"))
+                && !images.iter().any(|image: &ToolImageOutput| image.path == *path)
+            {
+                images.push(ToolImageOutput {
+                    path: path.clone(),
+                    mime_type,
+                });
+            }
+        }
+    }
+    images
