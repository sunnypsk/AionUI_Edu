+//! Mirrors the stored-message and Markdown fence boundaries of the pinned OpenUI client.
+//! This module never evaluates assistant-authored code.
+use std::sync::LazyLock;
+
+use regex::Regex;
+use sha2::{Digest, Sha256};
+
+static ROOT: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"(?m)^\s*root\s*=").unwrap());
+static ASSIGNMENT: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^\$?[A-Za-z_][A-Za-z_0-9]*\s*=").unwrap());
+static OPEN_FENCE: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^ {0,3}(`{3,}|~{3,})([^\n]*)").unwrap());
+static CLOSE_FENCE: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^ {0,3}(`{3,}|~{3,})[ \t]*\r?\n?$").unwrap());
+static MARKER: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^\]\]>openui:([a-z]+)(?:\?(.*))?$").unwrap());
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ProgramBlock {
+    pub profile: String,
+    pub program: String,
+    pub closed: bool,
+}
+
+impl ProgramBlock {
+    pub fn hash(&self) -> String {
+        format!("{:x}", Sha256::digest(self.program.as_bytes()))
+    }
+}
+
+/// Return the final content section; context and other envelope sections are never program text.
+fn message_content(input: &str) -> (String, String) {
+    let marker = "]]>openui:content";
+    let mut normalized = String::with_capacity(input.len());
+    let mut previous = 0;
+    for (index, _) in input.match_indices(marker) {
+        let suffix = &input[index + marker.len()..];
+        let valid =
+            suffix.is_empty() || suffix.starts_with('?') || suffix.starts_with('\n') || suffix.starts_with("\r\n");
+        if valid && index > previous && !input[..index].ends_with('\n') {
+            normalized.push_str(&input[previous..index]);
+            normalized.push('\n');
+            previous = index;
+        }
+    }
+    normalized.push_str(&input[previous..]);
+    let mut sections = vec![(String::new(), String::new(), Vec::<String>::new())];
+    for line in normalized.split('\n') {
+        let clean_line = line.strip_suffix('\r').unwrap_or(line);
+        if let Some(marker) = MARKER.captures(clean_line) {
+            if let Some(last) = sections.last_mut().and_then(|section| section.2.last_mut())
+                && last.ends_with('\r')
+            {
+                last.pop();
+            }
+            if &marker[1] == "end" {
+                continue;
+            }
+            let profile = marker
+                .get(2)
+                .map(|query| {
+                    url::form_urlencoded::parse(query.as_str().as_bytes())
+                        .filter(|(key, _)| key == "library")
+                        .map(|(_, value)| value.into_owned())
+                        .last()
+                        .unwrap_or_default()
+                })
+                .unwrap_or_default();
+            sections.push((marker[1].into(), profile, Vec::new()));
+        } else {
+            sections.last_mut().unwrap().2.push(line.into());
+        }
+    }
+    let winner = sections.iter().rposition(|section| section.0 == "content").unwrap_or(0);
+    let (_, library, lines) = &sections[winner];
+    (
+        lines.join("\n"),
+        if library == "openui-chat" {
+            "openui-chat"
+        } else {
+            "openui"
+        }
+        .into(),
+    )
+}
+
+pub(crate) fn blocks(input: &str) -> Vec<ProgramBlock> {
+    let (text, profile) = message_content(input);
+    let first = text
+        .lines()
+        .map(str::trim)
+        .find(|line| !line.is_empty() && !line.starts_with('#') && !line.starts_with("//"))
+        .unwrap_or("");
+    if ASSIGNMENT.is_match(first) && ROOT.is_match(&text) {
+        return vec![ProgramBlock {
+            profile,
+            program: text,
+            closed: true,
+        }];
+    }
+    let mut result = Vec::new();
+    let mut fence: Option<(char, usize, Option<ProgramBlock>)> = None;
+    for line in text.split_inclusive('\n') {
+        if let Some((character, length, block)) = fence.as_mut() {
+            let closing = CLOSE_FENCE
+                .captures(line)
+                .is_some_and(|capture| capture[1].starts_with(*character) && capture[1].len() >= *length);
+            if closing {
+                if let Some(mut complete) = block.take() {
+                    complete.closed = true;
+                    result.push(complete);
+                }
+                fence = None;
+            } else if let Some(block) = block {
+                block.program.push_str(line);
+            }
+            continue;
+        }
+        if let Some(open) = OPEN_FENCE.captures(line) {
+            let language = open[2].trim();
+            let block = matches!(language, "openui" | "openui-chat").then(|| ProgramBlock {
+                profile: language.into(),
+                program: String::new(),
+                closed: false,
+            });
+            fence = Some((open[1].chars().next().unwrap(), open[1].len(), block));
+        }
+    }
+    if let Some((_, _, Some(block))) = fence {
+        result.push(block);
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn markdown_fences_keep_profiles_and_program_bytes_separate() {
+        let found =
+            blocks("Before\n```openui\nroot = Stack([])\n```\nMiddle\n~~~openui-chat\nroot = Card([])\n~~~\nAfter");
+        assert_eq!(found.len(), 2);
+        assert_eq!(found[0].program, "root = Stack([])\n");
+        assert_eq!(found[1].profile, "openui-chat");
+    }
+
+    #[test]
+    fn ordinary_markdown_examples_do_not_create_interactive_blocks() {
+        assert!(blocks("````markdown\n```openui\nroot = Stack([])\n```\n````").is_empty());
+        assert!(blocks("Example: root = Stack([])").is_empty());
+    }
+
+    #[test]
+    fn incomplete_fences_remain_unavailable_for_state_writes() {
+        assert!(!blocks("```openui\nroot = Stack([")[0].closed);
+    }
+
+    #[test]
+    fn raw_programs_accept_state_and_helpers_before_root() {
+        let text = "# Lesson\n$topic = \"Poetry\"\nheading = TextContent($topic)\nroot = Stack([heading])";
+        assert_eq!(blocks(text)[0].program, text);
+    }
+
+    #[test]
+    fn official_envelopes_select_the_last_program_and_exclude_private_context() {
+        let found = blocks(
+            "]]>openui:content\nroot = Text(\"old\")\n]]>openui:content?library=openui-chat\nroot = Card([])\n]]>openui:context\n{\"secret\":\"private\"}\n]]>openui:end",
+        );
+        assert_eq!(found[0].profile, "openui-chat");
+        assert_eq!(found[0].program, "root = Card([])");
+        assert_eq!(found[0].hash().len(), 64);
+    }
+
+    #[test]
+    fn adjacent_retry_markers_do_not_change_the_winning_program() {
+        assert_eq!(
+            blocks("root = Text(\"old\")]]>openui:content\nroot = Text(\"new\")")[0].program,
+            "root = Text(\"new\")"
+        );
+    }
+}
