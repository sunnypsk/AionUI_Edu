+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct OpenUiCapabilities {
+    pub protocol: String,
+    pub hash: String,
+    pub versions: Value,
+    pub enabled: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct OpenUiState {
+    pub state: Map<String, Value>,
+    pub revision: i64,
+    pub program_hash: String,
+    pub library_id: String,
+    pub library_version: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct OpenUiTool {
+    pub key: String,
+    pub name: String,
+    pub description: Option<String>,
+    pub input_schema: Value,
+    pub read_only: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum OpenUiToolMode {
+    Query,
+    Mutation,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct OpenUiToolCall {
+    pub tool_key: String,
+    pub mode: OpenUiToolMode,
+    #[serde(default)]
+    pub arguments: Map<String, Value>,
+    pub message_id: String,
+    pub block_id: String,
+    pub program_hash: String,
+    pub operation_id: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct OpenUiActionContext {
+    pub message_id: String,
+    pub block_id: String,
+    pub form_state: Map<String, Value>,
+    pub form_name: Option<String>,
+    pub context: Option<Value>,
+}
+
+#[derive(Debug, Clone, Default, Deserialize)]
+pub struct OpenUiSendContext {
+    #[serde(default)]
+    pub ui_capabilities: Vec<String>,
+    pub ui_action: Option<OpenUiActionContext>,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct OpenUiSendMessageRequest {
+    #[serde(flatten)]
+    pub message: crate::SendMessageRequest,
+    #[serde(flatten)]
+    pub context: OpenUiSendContext,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct OpenUiTeamMessageRequest {
+    #[serde(flatten)]
+    pub message: crate::SendTeamMessageRequest,
+    #[serde(flatten)]
+    pub context: OpenUiSendContext,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct OpenUiTeamAgentMessageRequest {
+    #[serde(flatten)]
+    pub message: crate::SendAgentMessageRequest,
+    #[serde(flatten)]
+    pub context: OpenUiSendContext,
+}
