+#[derive(Default)]
+struct FakeState {
+    sequence: AtomicUsize,
+    counters: Mutex<HashMap<String, usize>>,
+    streams: Mutex<HashMap<String, mpsc::Sender<Event>>>,
+    cross_origin: bool,
+    cancellations: AtomicUsize,
+    started: tokio::sync::Notify,
+}
+
+fn response(state: &FakeState, session: &str, request: &Value) -> Option<Value> {
+    let id = request.get("id")?;
+    let result = match request["method"].as_str()? {
+        "initialize" => {
+            json!({ "protocolVersion":request["params"]["protocolVersion"], "capabilities":{"tools":{}}, "serverInfo":{"name":"isolated-openui-fixture","version":"1.0"} })
+        }
+        "tools/list" => tools(),
+        "tools/call" => {
+            let mut counters = state.counters.lock().unwrap();
+            let count = counters.entry(session.into()).or_default();
+            *count += 1;
+            json!({"content":[{"type":"text","text":"fixture result"}],"structuredContent":{"count":*count},"isError":request["params"]["name"]=="error"})
+        }
+        _ => json!({}),
+    };
+    Some(json!({"jsonrpc":"2.0","id":id,"result":result}))
+}
+
+async fn http(State(state): State<Arc<FakeState>>, headers: HeaderMap, Json(request): Json<Value>) -> Response {
+    if request["method"] == "notifications/cancelled" {
+        state.cancellations.fetch_add(1, Ordering::SeqCst);
+        return StatusCode::ACCEPTED.into_response();
+    }
+    if request["method"] == "tools/call" && request["params"]["name"] == "slow" {
+        state.started.notify_one();
+        tokio::time::sleep(Duration::from_secs(60)).await;
+    }
+    let session = if request["method"] == "initialize" {
+        format!("http-{}", state.sequence.fetch_add(1, Ordering::SeqCst))
+    } else {
+        headers
+            .get("mcp-session-id")
+            .and_then(|value| value.to_str().ok())
+            .unwrap_or("stateless")
+            .to_owned()
+    };
+    let Some(body) = response(&state, &session, &request) else {
+        return StatusCode::ACCEPTED.into_response();
+    };
+    let mut response_headers = HeaderMap::new();
+    response_headers.insert("mcp-session-id", session.parse().unwrap());
+    (response_headers, Json(body)).into_response()
+}
+
+async fn sse(State(state): State<Arc<FakeState>>) -> Response {
+    let session = format!("sse-{}", state.sequence.fetch_add(1, Ordering::SeqCst));
+    let endpoint = if state.cross_origin {
+        "http://example.invalid/messages".into()
+    } else {
+        format!("/messages?session={session}")
+    };
+    let (sender, receiver) = mpsc::channel::<Event>(16);
+    state.streams.lock().unwrap().insert(session, sender);
+    let first =
+        futures_util::stream::once(
+            async move { Ok::<_, Infallible>(Event::default().event("endpoint").data(endpoint)) },
+        );
+    let rest = futures_util::stream::unfold(receiver, |mut receiver| async {
+        receiver
+            .recv()
+            .await
+            .map(|event| (Ok::<_, Infallible>(event), receiver))
+    });
+    Sse::new(first.chain(rest)).into_response()
+}
+
+async fn messages(
+    State(state): State<Arc<FakeState>>,
+    Query(query): Query<HashMap<String, String>>,
+    Json(request): Json<Value>,
+) -> StatusCode {
+    let Some(session) = query.get("session") else {
+        return StatusCode::BAD_REQUEST;
+    };
+    if let Some(body) = response(&state, session, &request) {
+        let sender = state.streams.lock().unwrap().get(session).cloned();
+        let Some(sender) = sender else {
+            return StatusCode::NOT_FOUND;
+        };
+        if sender
+            .send(Event::default().event("message").data(body.to_string()))
+            .await
+            .is_err()
+        {
+            return StatusCode::GONE;
+        }
+    }
+    StatusCode::ACCEPTED
+}
+
+struct Server {
+    url: String,
+    task: tokio::task::JoinHandle<()>,
+    state: Arc<FakeState>,
+}
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn start_server(cross_origin: bool) -> Server {
+    let state = Arc::new(FakeState {
+        cross_origin,
+        ..Default::default()
+    });
+    let router = Router::new()
+        .route("/mcp", post(http).delete(|| async { StatusCode::NO_CONTENT }))
+        .route("/sse", get(sse))
+        .route("/messages", post(messages))
+        .with_state(state.clone());
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let task = tokio::spawn(async move {
+        axum::serve(listener, router).await.unwrap();
+    });
+    Server { url, task, state }
+}
