+fn stdio_server() -> SessionMcpServer {
+    let script = r#"
+import json, sys, time
+from pathlib import Path
+count = 0
+for line in sys.stdin:
+    request = json.loads(line)
+    if 'id' not in request: continue
+    method = request['method']
+    if method == 'initialize':
+        result = {'protocolVersion': request['params']['protocolVersion'], 'capabilities': {'tools': {}}, 'serverInfo': {'name': 'fixture', 'version': '1'}}
+    elif method == 'tools/list':
+        result = {'tools': [{'name': 'fetch', 'inputSchema': {'type': 'object'}, 'annotations': {'readOnlyHint': True}}, {'name': 'save', 'inputSchema': {'type': 'object'}}, {'name': 'slow', 'inputSchema': {'type': 'object'}}]}
+    elif method == 'tools/call':
+        if request['params']['name'] == 'slow':
+            Path(request['params']['arguments']['marker']).write_text('started')
+            time.sleep(60)
+        count += 1
+        result = {'content': [{'type': 'text', 'text': 'fixture result'}], 'structuredContent': {'count': count}, 'isError': False}
+    else: result = {}
+    print(json.dumps({'jsonrpc': '2.0', 'id': request['id'], 'result': result}), flush=True)
+"#;
+    SessionMcpServer {
+        id: "stdio".into(),
+        name: "stdio".into(),
+        transport: SessionMcpTransport::Stdio {
+            command: "python3".into(),
+            args: vec!["-u".into(), "-c".into(), script.into()],
+            env: HashMap::new(),
+        },
+    }
+}
