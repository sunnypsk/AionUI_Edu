+fn mime_guess_from_image_path(path: &str) -> &'static str {
+    let lower = path.to_ascii_lowercase();
+    if lower.ends_with(".jpg") || lower.ends_with(".jpeg") {
+        "image/jpeg"
+    } else if lower.ends_with(".webp") {
+        "image/webp"
+    } else if lower.ends_with(".gif") {
+        "image/gif"
+    } else {
+        "image/png"
+    }
+}
+
+fn parse_codex_inline_image(value: &str) -> Option<crate::event::ToolResultContent> {
+    use base64::Engine as _;
+    let (mime, encoded) = if let Some(data) = value.strip_prefix("data:") {
+        data.split_once(";base64,")?
+    } else {
+        ("image/png", value)
+    };
+    if !matches!(mime, "image/png" | "image/jpeg" | "image/webp" | "image/gif") || encoded.len() > 45 * 1024 * 1024 {
+        return None;
+    }
+    let data = base64::engine::general_purpose::STANDARD.decode(encoded).ok()?;
+    if data.is_empty() || data.len() > 32 * 1024 * 1024 {
+        return None;
+    }
+    Some(crate::event::ToolResultContent::Image {
+        media_type: mime.into(),
+        data,
+    })
+}
+
+fn parse_codex_image_result(result: Option<&Value>) -> Vec<crate::event::ToolResultContent> {
+    match result {
+        Some(Value::String(encoded)) => parse_codex_inline_image(encoded).into_iter().collect(),
+        Some(value @ Value::Array(_)) => parse_codex_dynamic_content_items(Some(value)),
+        _ => Vec::new(),
+    }
 }
 
