+        assert_eq!(service.list("alice", "conversation").len(), 1);
+        service.release("alice", "conversation");
+        assert!(matches!(reset.await.unwrap(), Err(ConversationError::Forbidden { .. })));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn unattended_confirmation_times_out_and_removes_the_card() {
+        let service = OpenUiPermissions::new(Arc::new(BroadcastEventBus::new(16)));
+        let task = pending(&service, "server/tool").await;
+        tokio::time::advance(Duration::from_secs(121)).await;
+        assert!(matches!(task.await.unwrap(), Err(ConversationError::Forbidden { .. })));
+        assert!(service.list("alice", "conversation").is_empty());
+    }
+}
