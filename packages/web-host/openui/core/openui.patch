+fn network_server(server: &Server, transport: &str) -> SessionMcpServer {
+    let url = format!("{}/{}", server.url, if transport == "sse" { "sse" } else { "mcp" });
+    SessionMcpServer {
+        id: "fixture".into(),
+        name: "fixture".into(),
+        transport: if transport == "sse" {
+            SessionMcpTransport::Sse {
+                url,
+                headers: HashMap::new(),
+            }
+        } else {
+            SessionMcpTransport::Http {
+                url,
+                headers: HashMap::new(),
+            }
+        },
+    }
+}
