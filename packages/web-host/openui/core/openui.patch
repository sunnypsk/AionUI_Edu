+use futures_util::stream::BoxStream;
+use mcp_reqwest::header::{HeaderName, HeaderValue};
+use rmcp::{
+    model::{ClientJsonRpcMessage, RequestId},
+    transport::streamable_http_client::{
+        SseError, StreamableHttpClient, StreamableHttpError, StreamableHttpPostResponse,
+    },
+};
+use sse_stream::Sse;
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+#[derive(Clone)]
+struct Target {
+    uri: Arc<str>,
+    session: Option<Arc<str>>,
+    auth: Option<String>,
+    headers: HashMap<HeaderName, HeaderValue>,
+}
+
+/// A protocol cancellation must not wait behind the HTTP POST it is cancelling.
+/// The SDK still owns initialization, session negotiation, requests and SSE parsing.
+#[derive(Clone)]
+pub(super) struct HttpCancellation {
+    client: mcp_reqwest::Client,
+    target: Arc<Mutex<Option<Target>>>,
+}
+
+impl HttpCancellation {
+    pub fn new(client: mcp_reqwest::Client) -> Self {
+        Self {
+            client,
+            target: Arc::new(Mutex::new(None)),
+        }
+    }
+
+    pub fn legacy(client: mcp_reqwest::Client, uri: &str, headers: &mcp_reqwest::header::HeaderMap) -> Self {
+        Self {
+            client,
+            target: Arc::new(Mutex::new(Some(Target {
+                uri: uri.into(),
+                session: None,
+                auth: None,
+                headers: headers
+                    .iter()
+                    .map(|(key, value)| (key.clone(), value.clone()))
+                    .collect(),
+            }))),
+        }
+    }
+
+    pub async fn cancel(&self, id: RequestId) {
+        let target = self.target.lock().ok().and_then(|target| target.clone());
+        let Some(target) = target else {
+            return;
+        };
+        let mut request = self
+            .client
+            .post(target.uri.as_ref())
+            .timeout(Duration::from_secs(5))
+            .header("Accept", "application/json, text/event-stream");
+        for (key, value) in target.headers {
+            request = request.header(key, value);
+        }
+        if let Some(session) = target.session {
+            request = request.header("Mcp-Session-Id", session.as_ref());
+        }
+        if let Some(auth) = target.auth {
+            request = request.bearer_auth(auth);
+        }
+        let _ = request.json(&serde_json::json!({"jsonrpc":"2.0","method":"notifications/cancelled","params":{"requestId":id,"reason":"OpenUI operation cancelled"}})).send().await;
+    }
+}
+
+#[derive(Clone)]
+pub(super) struct CancellableHttpClient {
+    pub cancellation: HttpCancellation,
+}
+
+impl StreamableHttpClient for CancellableHttpClient {
+    type Error = <mcp_reqwest::Client as StreamableHttpClient>::Error;
+
+    async fn post_message(
+        &self,
+        uri: Arc<str>,
+        message: ClientJsonRpcMessage,
+        session_id: Option<Arc<str>>,
+        auth_header: Option<String>,
+        custom_headers: HashMap<HeaderName, HeaderValue>,
+    ) -> Result<StreamableHttpPostResponse, StreamableHttpError<Self::Error>> {
+        if let Ok(mut target) = self.cancellation.target.lock() {
+            *target = Some(Target {
+                uri: uri.clone(),
+                session: session_id.clone(),
+                auth: auth_header.clone(),
+                headers: custom_headers.clone(),
+            });
+        }
+        self.cancellation
+            .client
+            .post_message(uri, message, session_id, auth_header, custom_headers)
+            .await
+    }
+
+    async fn delete_session(
+        &self,
+        uri: Arc<str>,
+        session_id: Arc<str>,
+        auth_header: Option<String>,
+        custom_headers: HashMap<HeaderName, HeaderValue>,
+    ) -> Result<(), StreamableHttpError<Self::Error>> {
+        self.cancellation
+            .client
+            .delete_session(uri, session_id, auth_header, custom_headers)
+            .await
+    }
+
+    async fn get_stream(
+        &self,
+        uri: Arc<str>,
+        session_id: Arc<str>,
+        last_event_id: Option<String>,
+        auth_header: Option<String>,
+        custom_headers: HashMap<HeaderName, HeaderValue>,
+    ) -> Result<BoxStream<'static, Result<Sse, SseError>>, StreamableHttpError<Self::Error>> {
+        self.cancellation
+            .client
+            .get_stream(uri, session_id, last_event_id, auth_header, custom_headers)
+            .await
+    }
+}
