+#[tokio::test]
+async fn edits_advance_revisions_without_rewriting_the_message() {
+    let (_db, repository, conversations, key) = setup().await;
+    let original = conversations
+        .get_message(USER, "conversation", "message")
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(repository.get(&key).await.unwrap().is_none());
+    let saved = repository.save(&key, &state(0, r#"{"name":"Ada"}"#)).await.unwrap();
+    assert_eq!(saved.revision, 1);
+    repository.save(&key, &state(1, r#"{"name":"Grace"}"#)).await.unwrap();
+    assert_eq!(
+        repository.get(&key).await.unwrap().unwrap().state_json,
+        r#"{"name":"Grace"}"#
+    );
+    assert_eq!(
+        conversations
+            .get_message(USER, "conversation", "message")
+            .await
+            .unwrap()
+            .unwrap(),
+        original
+    );
+}
