+    pub(crate) async fn owned_block(&self, key: &OpenUiStateKey) -> Result<ProgramBlock, ConversationError> {
+        let index: usize = key
+            .block_id
+            .parse()
+            .map_err(|_| bad_request("OPENUI_INVALID_BLOCK_ID"))?;
+        if index.to_string() != key.block_id || index > 10000 {
+            return Err(bad_request("OPENUI_INVALID_BLOCK_ID"));
+        }
+        let row = self
+            .conversations
+            .get_message(&key.user_id, &key.conversation_id, &key.message_id)
+            .await?
+            .ok_or_else(|| ConversationError::MessageNotFound {
+                id: key.message_id.clone(),
+            })?;
+        if row.r#type != "text" || row.position.as_deref() != Some("left") || row.status.as_deref() != Some("finish") {
+            return Err(bad_request("OPENUI_MESSAGE_NOT_FINAL"));
+        }
+        let stored: Value =
+            serde_json::from_str(&row.content).map_err(|_| bad_request("OPENUI_INVALID_MESSAGE_CONTENT"))?;
+        let content = stored
+            .get("content")
+            .and_then(Value::as_str)
+            .ok_or_else(|| bad_request("OPENUI_INVALID_MESSAGE_CONTENT"))?;
+        let block = blocks(content)
+            .into_iter()
+            .nth(index)
+            .ok_or_else(|| bad_request("OPENUI_BLOCK_NOT_FOUND"))?;
+        if !block.closed {
+            return Err(bad_request("OPENUI_INCOMPLETE_BLOCK"));
+        }
+        Ok(block)
+    }
