+    async fn recover_interrupted_conversation(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        rows: Vec<MessageRow>,
+        interrupted: bool,
+    ) -> Result<(), aionui_db::DbError> {
+        let Some(conversation) = self.conversation_repo().get(user_id, conversation_id).await? else {
+            return Ok(());
+        };
+        if interrupted {
+            // Claim legacy residue before settling it. A second crash can then still
+            // recover even if all message rows have already been closed.
+            self.conversation_repo()
+                .update(
+                    user_id,
+                    conversation_id,
+                    &ConversationRowUpdate {
+                        status: Some("running".into()),
+                        ..Default::default()
+                    },
+                )
+                .await?;
+        }
+        for row in rows {
+            let action = classify_recovery_action(&row);
+            let update = MessageRowUpdate {
+                content: if action == StartupRecoveryAction::SettleToolRow {
+                    settle_tool_row_content(&row.r#type, &row.content)
+                } else {
+                    None
+                },
+                status: Some(Some("finish".to_owned())),
+                hidden: Some(action == StartupRecoveryAction::FinishEmptyPlaceholder),
+            };
+            self.conversation_repo()
+                .update_message(user_id, conversation_id, &row.id, &update)
+                .await?;
+        }
+        if interrupted {
+            let page = self
+                .conversation_repo()
+                .list_messages_page(
+                    user_id,
+                    conversation_id,
+                    &MessagePageParams {
+                        limit: 1,
+                        direction: MessagePageDirection::InitialLatest,
+                    },
+                )
+                .await?;
+            let latest = page.items.last();
+            let already_notified = latest.is_some_and(|row| {
+                row.r#type == "tips"
+                    && serde_json::from_str::<serde_json::Value>(&row.content)
+                        .ok()
+                        .is_some_and(|value| value["code"] == "TURN_INTERRUPTED_BY_RESTART")
+            });
+            let tip = if !already_notified {
+                let id = format!(
+                    "restart-{}-{}",
+                    conversation_id,
+                    latest.map(|row| row.id.as_str()).unwrap_or("empty")
+                );
+                Some(MessageRow {
+                    id: id.clone(), conversation_id: conversation_id.into(), msg_id: Some(id),
+                    r#type: "tips".into(),
+                    content: serde_json::json!({
+                        "type": "warning", "code": "TURN_INTERRUPTED_BY_RESTART",
+                        "content": "The server restarted before this task finished. Existing results were preserved. Review them before continuing."
+                    }).to_string(),
+                    position: Some("left".into()), status: Some("finish".into()), hidden: false,
+                    created_at: latest.map_or(conversation.updated_at, |row| row.created_at.max(conversation.updated_at)).saturating_add(1),
+                    backend_turn_id: None,
+                })
+            } else {
+                None
+            };
+            self.conversation_repo()
+                .finish_startup_recovery(user_id, conversation_id, tip.as_ref())
+                .await?;
+            info!(conversation_id, "startup recovery preserved interrupted turn results");
+        }
+        Ok(())
     }
 }
 
