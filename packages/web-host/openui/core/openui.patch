+                .bind(&key.conversation_id)
+                .bind(&key.message_id)
+                .bind(&key.block_id)
+                .bind(&state.library_id)
+                .bind(&state.library_version)
+                .bind(&state.program_hash)
+                .bind(&state.state_json);
+        } else {
+            statement = statement
+                .bind(&state.state_json)
+                .bind(&key.user_id)
+                .bind(&key.conversation_id)
+                .bind(&key.message_id)
+                .bind(&key.block_id)
+                .bind(&state.library_id)
+                .bind(&state.library_version)
+                .bind(&state.program_hash)
