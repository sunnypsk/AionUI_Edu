+#[cfg(test)]
+mod generated_image_tests {
+    use super::*;
+    use aionui_session::{SessionEvent, ToolResultContent};
+    use base64::Engine as _;
+
+    fn png() -> Vec<u8> {
+        base64::engine::general_purpose::STANDARD
+            .decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+j8ioAAAAASUVORK5CYII=")
+            .unwrap()
+    }
+    fn result(bytes: Vec<u8>) -> SessionEvent {
+        SessionEvent::ToolResult {
+            tool_use_id: "call-generated".into(),
+            is_error: false,
+            content: vec![ToolResultContent::Image {
+                media_type: "image/png".into(),
+                data: bytes,
+            }],
+            parent_tool_use_id: None,
+        }
+    }
+    fn image_path(event: &SessionEvent) -> &str {
+        match event {
+            SessionEvent::ToolResult { content, .. } => match &content[0] {
+                ToolResultContent::FilePath { path, .. } => path,
+                _ => panic!("expected file reference"),
+            },
+            _ => panic!("expected result"),
+        }
+    }
+
+    #[tokio::test]
+    async fn generated_image_replay_reuses_the_original_bytes_and_one_artifact() {
+        let root = tempfile::tempdir().unwrap();
+        let bytes = png();
+        let mut first = result(bytes.clone());
+        materialize_tool_images(&mut first, root.path().to_str().unwrap()).await;
+        let mut replay = result(bytes.clone());
+        materialize_tool_images(&mut replay, root.path().to_str().unwrap()).await;
+        assert_eq!(image_path(&first), image_path(&replay));
+        assert_eq!(std::fs::read(image_path(&first)).unwrap(), bytes);
+        assert_eq!(
+            std::fs::read_dir(root.path().join(".aionui-generated-images"))
+                .unwrap()
+                .count(),
+            1
+        );
+    }
+
+    #[tokio::test]
+    async fn generated_image_large_png_is_kept_out_of_the_serialized_result() {
+        // A valid PNG with a 3 MiB ancillary text chunk, generated in memory.
+        let small = png();
+        let mut bytes = small[..small.len() - 12].to_vec();
+        let mut chunk = b"tEXtfixture\0".to_vec();
+        chunk.resize(3 * 1024 * 1024, b'x');
+        let mut crc = u32::MAX;
+        for byte in &chunk {
+            crc ^= u32::from(*byte);
+            for _ in 0..8 {
+                crc = (crc >> 1) ^ (0xedb88320 & (0u32.wrapping_sub(crc & 1)));
+            }
+        }
+        bytes.extend_from_slice(&((chunk.len() - 4) as u32).to_be_bytes());
+        bytes.extend_from_slice(&chunk);
+        bytes.extend_from_slice(&(!crc).to_be_bytes());
+        bytes.extend_from_slice(&small[small.len() - 12..]);
+        let root = tempfile::tempdir().unwrap();
+        let mut event = result(bytes.clone());
+        materialize_tool_images(&mut event, root.path().to_str().unwrap()).await;
+        assert_eq!(std::fs::read(image_path(&event)).unwrap(), bytes);
+        assert!(serde_json::to_string(&event).unwrap().len() < 1000);
+    }
+
+    #[tokio::test]
+    async fn generated_image_conflict_does_not_overwrite_an_earlier_result() {
+        let root = tempfile::tempdir().unwrap();
+        let bytes = png();
+        let mut first = result(bytes.clone());
+        materialize_tool_images(&mut first, root.path().to_str().unwrap()).await;
+        let mut changed = bytes.clone();
+        changed.push(1);
+        let mut replay = result(changed);
+        materialize_tool_images(&mut replay, root.path().to_str().unwrap()).await;
+        assert!(matches!(replay, SessionEvent::ToolResult { is_error: true, .. }));
+        assert_eq!(std::fs::read(image_path(&first)).unwrap(), bytes);
+    }
+
+    #[tokio::test]
+    async fn generated_image_failed_tool_does_not_write_or_publish_bytes() {
+        let root = tempfile::tempdir().unwrap();
