+use async_trait::async_trait;
+use sqlx::SqlitePool;
+
+use crate::DbError;
+use crate::models::OpenUiStateRow;
+
+/// An account-owned persisted assistant block. Message IDs are database row IDs.
+#[derive(Debug, Clone)]
+pub struct OpenUiStateKey {
+    pub user_id: String,
+    pub conversation_id: String,
+    pub message_id: String,
+    pub block_id: String,
+}
+
+pub enum OpenUiOperationClaim {
+    Claimed,
+    Pending,
+    Replay(String),
+}
+
+#[async_trait]
+pub trait IOpenUiRepository: Send + Sync {
+    async fn get(&self, key: &OpenUiStateKey) -> Result<Option<OpenUiStateRow>, DbError>;
+    /// Atomically save the next revision, rejecting stale writers.
+    async fn save(&self, key: &OpenUiStateKey, state: &OpenUiStateRow) -> Result<OpenUiStateRow, DbError>;
+    /// Reserve a mutation before dispatch. Pending operations must never be redispatched.
+    async fn claim_operation(
+        &self,
+        key: &OpenUiStateKey,
+        operation_id: &str,
+        fingerprint: &str,
+    ) -> Result<OpenUiOperationClaim, DbError>;
+    async fn complete_operation(
+        &self,
+        key: &OpenUiStateKey,
+        operation_id: &str,
+        fingerprint: &str,
+        result: &str,
+    ) -> Result<(), DbError>;
+}
+
+pub struct SqliteOpenUiRepository {
+    pool: SqlitePool,
+}
+
+impl SqliteOpenUiRepository {
+    pub fn new(pool: SqlitePool) -> Self {
+        Self { pool }
+    }
+}
+
+const OWNED_MESSAGE: &str = "SELECT 1 FROM messages m JOIN conversations c ON c.id=m.conversation_id \
+    WHERE c.user_id=? AND c.id=? AND m.id=? AND m.type='text' AND m.position='left' AND m.status='finish'";
+
+#[async_trait]
+impl IOpenUiRepository for SqliteOpenUiRepository {
+    async fn get(&self, key: &OpenUiStateKey) -> Result<Option<OpenUiStateRow>, DbError> {
+        let query = format!(
+            "SELECT library_id,library_version,program_hash,state_json,revision FROM openui_states \
+             WHERE user_id=? AND conversation_id=? AND message_id=? AND block_id=? AND EXISTS ({OWNED_MESSAGE})"
+        );
+        Ok(sqlx::query_as(&query)
+            .bind(&key.user_id)
+            .bind(&key.conversation_id)
+            .bind(&key.message_id)
+            .bind(&key.block_id)
+            .bind(&key.user_id)
+            .bind(&key.conversation_id)
+            .bind(&key.message_id)
+            .fetch_optional(&self.pool)
+            .await?)
+    }
+
+    async fn save(&self, key: &OpenUiStateKey, state: &OpenUiStateRow) -> Result<OpenUiStateRow, DbError> {
+        let query = if state.revision == 0 {
+            format!(
+                "INSERT INTO openui_states \
+                (user_id,conversation_id,message_id,block_id,library_id,library_version,program_hash,state_json,revision) \
+                SELECT ?,?,?,?,?,?,?,?,1 WHERE EXISTS ({OWNED_MESSAGE}) \
+                ON CONFLICT DO NOTHING"
+            )
+        } else {
+            format!(
+                "UPDATE openui_states SET state_json=?,revision=revision+1 \
+                WHERE user_id=? AND conversation_id=? AND message_id=? AND block_id=? \
+                AND library_id=? AND library_version=? AND program_hash=? AND revision=? \
+                AND EXISTS ({OWNED_MESSAGE})"
+            )
+        };
+        let mut statement = sqlx::query(&query);
+        if state.revision == 0 {
+            statement = statement
+                .bind(&key.user_id)
+                .bind(&key.conversation_id)
+                .bind(&key.message_id)
+                .bind(&key.block_id)
+                .bind(&state.library_id)
+                .bind(&state.library_version)
+                .bind(&state.program_hash)
+                .bind(&state.state_json);
+        } else {
+            statement = statement
+                .bind(&state.state_json)
+                .bind(&key.user_id)
+                .bind(&key.conversation_id)
+                .bind(&key.message_id)
+                .bind(&key.block_id)
+                .bind(&state.library_id)
+                .bind(&state.library_version)
+                .bind(&state.program_hash)
+                .bind(state.revision);
+        }
+        let changed = statement
+            .bind(&key.user_id)
+            .bind(&key.conversation_id)
+            .bind(&key.message_id)
+            .execute(&self.pool)
+            .await?
+            .rows_affected();
+        if changed != 1 {
+            return Err(DbError::Conflict("OPENUI_STATE_REVISION_CONFLICT".into()));
+        }
+        // Return this write's revision, even if another writer has already advanced it.
+        let mut saved = state.clone();
+        saved.revision += 1;
+        Ok(saved)
+    }
+
+    async fn claim_operation(
+        &self,
+        key: &OpenUiStateKey,
+        operation_id: &str,
+        fingerprint: &str,
+    ) -> Result<OpenUiOperationClaim, DbError> {
+        let query = format!(
+            "INSERT INTO openui_operations \
+            (user_id,conversation_id,message_id,operation_id,fingerprint) \
+            SELECT ?,?,?,?,? WHERE EXISTS ({OWNED_MESSAGE}) ON CONFLICT DO NOTHING"
+        );
+        let changed = sqlx::query(&query)
+            .bind(&key.user_id)
+            .bind(&key.conversation_id)
+            .bind(&key.message_id)
+            .bind(operation_id)
+            .bind(fingerprint)
+            .bind(&key.user_id)
+            .bind(&key.conversation_id)
+            .bind(&key.message_id)
+            .execute(&self.pool)
+            .await?
+            .rows_affected();
+        if changed == 1 {
+            return Ok(OpenUiOperationClaim::Claimed);
+        }
+        let row: Option<(String, Option<String>)> = sqlx::query_as(
+            "SELECT fingerprint,result_json FROM openui_operations WHERE user_id=? AND conversation_id=? AND operation_id=?"
+        ).bind(&key.user_id).bind(&key.conversation_id).bind(operation_id)
+            .fetch_optional(&self.pool).await?;
+        match row {
+            Some((original, result)) if original == fingerprint => Ok(match result {
+                Some(result) => OpenUiOperationClaim::Replay(result),
+                None => OpenUiOperationClaim::Pending,
+            }),
+            Some(_) => Err(DbError::Conflict("OPENUI_OPERATION_ID_REUSED".into())),
+            None => Err(DbError::NotFound("OPENUI_MESSAGE_NOT_FOUND".into())),
+        }
+    }
+
+    async fn complete_operation(
+        &self,
+        key: &OpenUiStateKey,
+        operation_id: &str,
+        fingerprint: &str,
+        result: &str,
+    ) -> Result<(), DbError> {
+        let changed = sqlx::query("UPDATE openui_operations SET result_json=? \
+            WHERE user_id=? AND conversation_id=? AND message_id=? AND operation_id=? AND fingerprint=? AND result_json IS NULL")
