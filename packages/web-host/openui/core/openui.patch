+
+    fn image_item(extra: Value) -> Value {
+        let mut item = json!({"type":"imageGeneration","id":"call_fixture","status":"completed"});
+        item.as_object_mut().unwrap().extend(extra.as_object().unwrap().clone());
+        json!({"threadId":"fixture-thread","turnId":"fixture-turn","item":item})
+    }
+
+    #[test]
+    fn generated_image_saved_path_aliases_prefer_file_references() {
+        for extra in [
+            json!({"savedPath":"/owned/generated.png","result":"large-base64-is-not-text"}),
+            json!({"savedPath":null,"saved_path":"/owned/generated.png"}),
+        ] {
+            let events = map_item(&image_item(extra), true);
+            assert!(events.iter().any(|event| matches!(event, SessionEvent::ToolResult { is_error:false, content, .. }
+                if matches!(content.as_slice(), [ToolResultContent::FilePath { path, .. }] if path == "/owned/generated.png"))));
+        }
+    }
+
+    #[test]
+    fn generated_image_native_content_array_keeps_bytes_out_of_text() {
+        // Captured native imagegen output used input_image/image_url + input_text blocks.
+        // The app-server schema's imageGeneration variant is verified with Codex 0.163.0
+        // generated v2/ThreadItemsListResponse.json; both result carriers are accepted.
+        let bytes = vec![0x89; 128 * 1024];
+        let encoded = base64::engine::general_purpose::STANDARD.encode(&bytes);
+        let params = image_item(
+            json!({"result":[{"type":"input_image","image_url":format!("data:image/png;base64,{encoded}")},
+                                                   {"type":"input_text","text":"Generated image saved"}]}),
+        );
+        let events = map_item(&params, true);
+        assert!(events.iter().any(
+            |event| matches!(event, SessionEvent::ToolResult { is_error:false, content, .. }
+            if content.iter().any(|part| matches!(part, ToolResultContent::Image { data, .. } if data == &bytes)))
+        ));
+        assert!(
+            !events
+                .iter()
+                .any(|event| matches!(event, SessionEvent::ToolResult { content, .. }
+            if content.iter().any(|part| matches!(part, ToolResultContent::Text(text) if text.contains(&encoded)))))
+        );
+    }
+
+    #[test]
+    fn generated_image_failure_never_exposes_a_success_artifact() {
+        let events = map_item(
+            &image_item(json!({"savedPath":"/owned/partial.png","failure":{"message":"failed"}})),
+            true,
+        );
+        assert!(events.iter().any(
+            |event| matches!(event, SessionEvent::ToolResult { is_error:true, content, .. } if content.is_empty())
+        ));
+    }
+
