+// ---------------------------------------------------------------------------
+// Watch lifecycle races: real loopback listeners, controlled startup timing
+// ---------------------------------------------------------------------------
+
+type ListenerState = Arc<std::sync::Mutex<Option<std::net::TcpListener>>>;
+
+struct ControlledHandle {
+    listener: ListenerState,
+}
+
+impl ProcessHandle for ControlledHandle {
+    fn kill(&self) {
+        self.listener.lock().unwrap().take();
+    }
+
+    fn is_alive(&self) -> bool {
+        self.listener.lock().unwrap().is_some()
+    }
+}
+
+struct ControlledSpawner {
+    first_started: tokio::sync::Notify,
+    release_first: tokio::sync::Semaphore,
+    spawn_count: AtomicU32,
+    fail_first: bool,
+    listeners: std::sync::Mutex<Vec<ListenerState>>,
+}
+
+impl ControlledSpawner {
+    fn new(fail_first: bool) -> Self {
+        Self {
+            first_started: tokio::sync::Notify::new(),
+            release_first: tokio::sync::Semaphore::new(0),
+            spawn_count: AtomicU32::new(0),
+            fail_first,
+            listeners: std::sync::Mutex::new(Vec::new()),
+        }
+    }
+
+    fn live_ports(&self) -> Vec<u16> {
+        self.listeners
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|listener| {
+                listener
+                    .lock()
+                    .unwrap()
+                    .as_ref()
+                    .map(|listener| listener.local_addr().unwrap().port())
+            })
+            .collect()
+    }
+}
+
+#[async_trait::async_trait]
+impl ProcessSpawner for ControlledSpawner {
+    async fn spawn_officecli(
+        &self,
+        _file_path: &str,
+        port: u16,
+        _doc_type: DocType,
+    ) -> Result<Box<dyn ProcessHandle>, OfficeError> {
+        if self.spawn_count.fetch_add(1, Ordering::SeqCst) == 0 {
+            self.first_started.notify_one();
+            self.release_first.acquire().await.unwrap().forget();
+            if self.fail_first {
+                return Err(OfficeError::StartFailed("controlled startup failure".into()));
+            }
+        }
+        let listener = std::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, port))
+            .map_err(|error| OfficeError::StartFailed(error.to_string()))?;
+        let listener = Arc::new(std::sync::Mutex::new(Some(listener)));
+        self.listeners.lock().unwrap().push(Arc::clone(&listener));
+        Ok(Box::new(ControlledHandle { listener }))
+    }
+
+    async fn install_officecli(&self) -> Result<(), OfficeError> {
+        Ok(())
+    }
+
+    async fn is_officecli_installed(&self) -> bool {
+        true
+    }
+
+    async fn check_update(&self, _doc_type: DocType) -> Result<(), OfficeError> {
+        Ok(())
+    }
+}
