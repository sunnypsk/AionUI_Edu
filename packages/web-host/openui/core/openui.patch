+#[tokio::test]
+async fn block_ids_are_canonical_and_must_exist() {
+    let (service, mut key, _) = service("root = Text(\"Hello\")").await;
+    for invalid in ["00", "-1", "999999999999999999999999999999999999999"] {
+        key.block_id = invalid.into();
+        assert!(
+            matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_INVALID_BLOCK_ID")
+        );
+    }
+    key.block_id = "1".into();
+    assert!(
+        matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_BLOCK_NOT_FOUND")
+    );
+}
+
+#[tokio::test]
+async fn an_unclosed_program_does_not_enable_state_writes() {
+    let (service, key, _) = service("```openui\nroot = Stack([").await;
+    assert!(
+        matches!(service.read_state(&key).await, Err(ConversationError::BadRequest { reason }) if reason == "OPENUI_INCOMPLETE_BLOCK")
+    );
+}
+
+#[tokio::test]
+async fn a_stale_device_receives_a_revision_conflict() {
+    let (service, key, _) = service("root = Text(\"Hello\")").await;
+    let stale = service.read_state(&key).await.unwrap();
+    service.write_state(&key, stale.clone()).await.unwrap();
+    assert!(
+        matches!(service.write_state(&key, stale).await, Err(ConversationError::Busy { reason }) if reason == "OPENUI_STATE_REVISION_CONFLICT")
+    );
+}
+
+#[tokio::test]
+async fn disabling_generation_preserves_historical_interaction_state() {
+    let (service, key, preferences) = service("root = Text(\"Hello\")").await;
+    assert!(service.generation_enabled(USER).await.unwrap());
+    preferences
+        .upsert_batch(USER, &[("openuiEnabled", "false")])
+        .await
+        .unwrap();
+    assert!(!service.generation_enabled(USER).await.unwrap());
+    assert_eq!(service.read_state(&key).await.unwrap().revision, 0);
+}
+
+#[tokio::test]
+async fn negative_revisions_and_oversized_state_are_rejected() {
