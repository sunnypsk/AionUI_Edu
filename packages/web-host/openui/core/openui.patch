+
+impl OpenUiService {
+    pub(super) fn profile_prompt(&self, profile: &str) -> &str {
+        self.manifest["libraries"][profile]["prompt"]
+            .as_str()
+            .unwrap_or_default()
+    }
+    pub fn new(
+        states: Arc<dyn IOpenUiRepository>,
+        conversations: Arc<dyn IConversationRepository>,
+        preferences: Arc<dyn IClientPreferenceRepository>,
+    ) -> Self {
+        Self {
+            states,
+            conversations,
+            preferences,
+            runtime: None,
+            manifest: serde_json::from_str(MANIFEST).expect("generated OpenUI manifest must be valid JSON"),
+        }
+    }
+
+    pub fn with_runtime(
+        mut self,
+        execution: aionui_mcp::McpExecutionService,
+        broadcaster: Arc<dyn aionui_realtime::EventBroadcaster>,
+    ) -> Self {
+        self.runtime = Some(super::runtime::OpenUiRuntime::new(execution, broadcaster));
+        self
+    }
