+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+};
+
+use std::time::{Duration, Instant};
+use tokio::sync::watch;
+
+use crate::ConversationError;
+
+type Key = (String, String, String);
+
+#[derive(Clone, Default)]
+pub(super) struct ActiveOperations(Arc<Mutex<Entries>>);
+
+#[derive(Default)]
+struct Entries {
+    active: HashMap<Key, watch::Sender<bool>>,
+    cancelled: HashMap<Key, Instant>,
+}
+
+pub(super) struct OperationGuard {
+    owner: ActiveOperations,
+    key: Key,
+}
+
+impl Drop for OperationGuard {
+    fn drop(&mut self) {
+        if let Ok(mut entries) = self.owner.0.lock() {
+            entries.active.remove(&self.key);
+        }
+    }
+}
+
+impl ActiveOperations {
+    pub fn begin(
+        &self,
+        user: &str,
+        conversation: &str,
+        operation: &str,
+    ) -> Result<(OperationGuard, watch::Receiver<bool>), ConversationError> {
+        let key = (user.into(), conversation.into(), operation.into());
+        let mut entries = self
+            .0
+            .lock()
+            .map_err(|_| ConversationError::internal("OPENUI_OPERATION_SERVICE_UNAVAILABLE"))?;
+        entries
+            .cancelled
+            .retain(|_, time| time.elapsed() < Duration::from_secs(300));
+        if entries.cancelled.contains_key(&key) {
+            return Err(ConversationError::Busy {
+                reason: "OPENUI_OPERATION_CANCELLED".into(),
+            });
+        }
+        if entries.active.contains_key(&key) {
+            return Err(ConversationError::Busy {
+                reason: "OPENUI_OPERATION_IN_PROGRESS".into(),
+            });
+        }
+        if entries.active.keys().filter(|key| key.0 == user).count() >= 32 {
+            return Err(ConversationError::RateLimited);
+        }
+        let (sender, receiver) = watch::channel(false);
+        entries.active.insert(key.clone(), sender);
+        Ok((
+            OperationGuard {
+                owner: self.clone(),
+                key,
+            },
+            receiver,
+        ))
+    }
+
+    pub fn cancel(&self, user: &str, conversation: &str, operation: &str) {
+        if let Ok(mut entries) = self.0.lock() {
+            let key = (user.into(), conversation.into(), operation.into());
+            if let Some(sender) = entries.active.get(&key) {
+                let _ = sender.send(true);
+            }
+            entries
+                .cancelled
+                .retain(|_, time| time.elapsed() < Duration::from_secs(300));
+            // The cancellation request may overtake the authenticated call during source validation.
+            if entries.cancelled.keys().filter(|key| key.0 == user).count() < 128 {
+                entries.cancelled.insert(key, Instant::now());
+            }
+        }
+    }
+
+    pub fn release(&self, user: &str, conversation: &str) {
+        if let Ok(entries) = self.0.lock() {
+            for (_, sender) in entries
+                .active
+                .iter()
+                .filter(|(key, _)| key.0 == user && key.1 == conversation)
+            {
+                let _ = sender.send(true);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn cancellation_and_duplicate_detection_are_scoped_to_the_owner_and_conversation() {
+        let operations = ActiveOperations::default();
+        let (guard, mut cancelled) = operations.begin("alice", "one", "operation").unwrap();
+        let (_other, other_cancelled) = operations.begin("bob", "one", "operation").unwrap();
+        assert!(operations.begin("alice", "one", "operation").is_err());
+        operations.cancel("alice", "two", "operation");
+        assert!(!*cancelled.borrow());
+        operations.cancel("alice", "one", "operation");
+        cancelled.changed().await.unwrap();
+        assert!(*cancelled.borrow());
+        assert!(!*other_cancelled.borrow());
+        drop(guard);
+        assert!(operations.begin("alice", "one", "operation").is_err());
+        assert!(operations.begin("alice", "one", "fresh-operation").is_ok());
+        operations.cancel("alice", "one", "arrives-later");
+        assert!(operations.begin("alice", "one", "arrives-later").is_err());
+    }
+}
