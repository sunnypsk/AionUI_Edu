+#[tokio::test]
+async fn oauth_refresh_is_single_flight_across_clones_and_logout_removes_the_token() {
+    use aionui_db::{IOAuthTokenRepository, UpsertOAuthTokenParams};
+    use axum::extract::Form;
+    let db = init_database_memory().await.unwrap();
+    let repo = Arc::new(SqliteOAuthTokenRepository::new(db.pool().clone()));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let endpoint = url.clone();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let counter = calls.clone();
+    let router = Router::new()
+        .route("/.well-known/oauth-authorization-server", get(move || { let endpoint = endpoint.clone(); async move { Json(json!({"authorization_endpoint":format!("{endpoint}/authorize"),"token_endpoint":format!("{endpoint}/token")})) } }))
+        .route("/token", post(move |Form(form): Form<HashMap<String,String>>| { let counter = counter.clone(); async move {
+            assert_eq!(form["refresh_token"], "fixture-refresh-1");
+            counter.fetch_add(1, Ordering::SeqCst);
+            Json(json!({"access_token":"fixture-access-2","refresh_token":"fixture-refresh-2","token_type":"Bearer","expires_in":3600}))
+        } }));
+    let task = tokio::spawn(async move {
+        axum::serve(listener, router).await.unwrap();
+    });
+    repo.upsert(UpsertOAuthTokenParams {
+        user_id: "system_default_user",
+        server_url: &url,
+        access_token: "expired",
+        refresh_token: Some("fixture-refresh-1"),
+        token_type: "bearer",
+        expires_at: Some(1),
+    })
+    .await
+    .unwrap();
+    let oauth = McpOAuthService::new(repo.clone(), reqwest::Client::new());
+    let results = futures_util::future::join_all((0..8).map(|_| {
+        let oauth = oauth.clone();
+        let url = url.clone();
+        async move { oauth.get_token("system_default_user", &url).await.unwrap() }
+    }))
+    .await;
+    assert!(results.iter().all(|token| token.as_deref() == Some("fixture-access-2")));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(oauth.get_token("different-account", &url).await.unwrap().is_none());
+    oauth.logout("system_default_user", &url).await.unwrap();
+    assert!(oauth.get_token("system_default_user", &url).await.unwrap().is_none());
+    task.abort();
