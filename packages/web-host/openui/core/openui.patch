+/// Persist inline tool images in the owning conversation before publishing its result.
+/// Existing file references are retained byte-for-byte. Replay never creates a second artifact.
+pub(crate) async fn materialize_tool_images(event: &mut aionui_session::SessionEvent, workspace: &str) {
+    use aionui_session::{SessionEvent, ToolResultContent};
+    let SessionEvent::ToolResult {
+        tool_use_id,
+        is_error,
+        content,
+        ..
+    } = event
+    else {
+        return;
+    };
+    let mut normalized = Vec::with_capacity(content.len());
+    for (index, part) in std::mem::take(content).into_iter().enumerate() {
+        let ToolResultContent::Image { media_type, data } = part else {
+            normalized.push(part);
+            continue;
+        };
+        if *is_error {
+            continue;
+        }
+        let workspace = workspace.to_owned();
+        let call_id = tool_use_id.clone();
+        match tokio::task::spawn_blocking(move || persist_tool_image(&workspace, &call_id, index, &media_type, &data))
+            .await
+        {
+            Ok(Ok(path)) => normalized.push(ToolResultContent::FilePath {
+                path,
+                mime: None,
+                old_text: None,
+                new_text: None,
+            }),
+            _ => {
+                *is_error = true;
+                normalized.push(ToolResultContent::Text("IMAGE_OUTPUT_SAVE_FAILED".into()));
+                warn!(
+                    code = "IMAGE_OUTPUT_SAVE_FAILED",
+                    "Generated image could not be persisted"
+                );
+            }
+        }
+    }
+    *content = normalized;
+}
+
+fn persist_tool_image(
+    workspace: &str,
+    call_id: &str,
+    index: usize,
+    mime: &str,
+    bytes: &[u8],
+) -> std::io::Result<String> {
+    use sha2::{Digest, Sha256};
+    use std::io::{Error, ErrorKind, Read, Write};
+    let extension = match mime {
+        "image/png" if bytes.starts_with(b"\x89PNG\r\n\x1a\n") => "png",
+        "image/jpeg" if bytes.starts_with(b"\xff\xd8\xff") => "jpg",
+        "image/webp" if bytes.starts_with(b"RIFF") && bytes.get(8..12) == Some(b"WEBP") => "webp",
+        "image/gif" if bytes.starts_with(b"GIF8") => "gif",
+        _ => return Err(Error::new(ErrorKind::InvalidData, "Unsupported raster image")),
+    };
+    if bytes.len() > 32 * 1024 * 1024 {
+        return Err(Error::new(ErrorKind::InvalidData, "Image exceeds output limit"));
+    }
+    let root = std::fs::canonicalize(workspace)?;
+    let directory = root.join(".aionui-generated-images");
+    match std::fs::create_dir(&directory) {
+        Ok(()) => {}
+        Err(error) if error.kind() == ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error),
+    }
+    if std::fs::symlink_metadata(&directory)?.file_type().is_symlink()
+        || std::fs::canonicalize(&directory)? != directory
+    {
+        return Err(Error::new(
+            ErrorKind::PermissionDenied,
+            "Image output directory is not owned by this workspace",
+        ));
+    }
+    let key = format!("{:x}", Sha256::digest(format!("{call_id}:{index}")));
+    let destination = directory.join(format!("{key}.{extension}"));
+    let mut temporary = tempfile::NamedTempFile::new_in(&directory)?;
+    temporary.write_all(bytes)?;
+    temporary.as_file().sync_all()?;
+    match temporary.persist_noclobber(&destination) {
+        Ok(_) => {}
+        Err(error) if error.error.kind() == ErrorKind::AlreadyExists => {
+            let mut options = std::fs::OpenOptions::new();
+            options.read(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.custom_flags(libc::O_NOFOLLOW);
+            }
+            if std::fs::symlink_metadata(&destination)?.file_type().is_symlink() {
+                return Err(Error::new(ErrorKind::PermissionDenied, "Image output is a symlink"));
+            }
+            let mut existing = options.open(&destination)?;
+            if existing.metadata()?.len() != bytes.len() as u64 {
+                return Err(Error::new(ErrorKind::AlreadyExists, "Image replay differs"));
+            }
+            let mut saved = Vec::with_capacity(bytes.len());
+            existing.read_to_end(&mut saved)?;
+            if saved != bytes {
+                return Err(Error::new(ErrorKind::AlreadyExists, "Image replay differs"));
+            }
+        }
+        Err(error) => return Err(error.error),
+    }
+    Ok(destination.to_string_lossy().into_owned())
+}
 
