+    pub async fn read_state(&self, key: &OpenUiStateKey) -> Result<OpenUiState, ConversationError> {
+        let block = self.owned_block(key).await?;
+        let expected = self.empty_state(&block);
+        let Some(row) = self.states.get(key).await? else {
+            return Ok(expected);
+        };
+        let actual = OpenUiState {
+            state: serde_json::from_str(&row.state_json)
+                .map_err(|_| ConversationError::internal("OPENUI_INVALID_SAVED_STATE"))?,
+            revision: row.revision,
+            program_hash: row.program_hash,
+            library_id: row.library_id,
+            library_version: row.library_version,
+        };
+        ensure_metadata(&actual, &expected)?;
+        Ok(actual)
+    }
+
+    pub async fn write_state(
+        &self,
+        key: &OpenUiStateKey,
+        state: OpenUiState,
+    ) -> Result<OpenUiState, ConversationError> {
+        let block = self.owned_block(key).await?;
+        ensure_metadata(&state, &self.empty_state(&block))?;
+        if state.revision < 0 || state.revision >= i64::from(i32::MAX) {
+            return Err(bad_request("OPENUI_INVALID_REVISION"));
+        }
+        let json = serde_json::to_string(&state.state).map_err(|_| bad_request("OPENUI_INVALID_STATE"))?;
+        if json.len() > MAX_STATE_BYTES {
+            return Err(bad_request("OPENUI_STATE_TOO_LARGE"));
+        }
+        let row = self
+            .states
+            .save(
+                key,
+                &OpenUiStateRow {
+                    state_json: json,
+                    revision: state.revision,
+                    program_hash: state.program_hash.clone(),
+                    library_id: state.library_id.clone(),
+                    library_version: state.library_version.clone(),
+                },
+            )
+            .await
+            .map_err(|error| match error {
+                aionui_db::DbError::Conflict(_) => ConversationError::Busy {
+                    reason: "OPENUI_STATE_REVISION_CONFLICT".into(),
+                },
+                error => error.into(),
+            })?;
+        Ok(OpenUiState {
+            revision: row.revision,
+            ..state
+        })
+    }
+
+    fn empty_state(&self, block: &ProgramBlock) -> OpenUiState {
+        OpenUiState {
+            state: Map::new(),
+            revision: 0,
+            program_hash: block.hash(),
+            library_id: block.profile.clone(),
+            library_version: self.manifest["versions"]["ui"].as_str().unwrap_or_default().into(),
+        }
+    }
+}
+
+fn bad_request(reason: &str) -> ConversationError {
+    ConversationError::BadRequest { reason: reason.into() }
+}
+
+fn ensure_metadata(actual: &OpenUiState, expected: &OpenUiState) -> Result<(), ConversationError> {
+    if actual.program_hash != expected.program_hash
+        || actual.library_id != expected.library_id
+        || actual.library_version != expected.library_version
+    {
+        return Err(ConversationError::Busy {
+            reason: "OPENUI_PROGRAM_VERSION_CONFLICT".into(),
+        });
+    }
+    Ok(())
+}
