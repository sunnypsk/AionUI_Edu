+#![allow(clippy::disallowed_types)]
+
+use aionui_api_types::{ApiResponse, OpenUiCapabilities, OpenUiState, OpenUiTool, OpenUiToolCall};
+use aionui_auth::CurrentUser;
+use aionui_common::ApiError;
+use aionui_db::OpenUiStateKey;
+use axum::{
+    Json, Router,
+    extract::{Extension, Path, State},
+    routing::{get, post},
+};
+
+use crate::state::ConversationRouterState;
+
+pub(crate) fn routes() -> Router<ConversationRouterState> {
+    Router::new()
+        .route("/api/openui/capabilities", get(capabilities))
+        .route("/api/conversations/{id}/openui/tools", get(tools))
+        .route("/api/conversations/{id}/openui/tools/call", post(call))
+        .route(
+            "/api/conversations/{id}/openui/operations/{operation}/cancel",
+            post(cancel),
+        )
+        .route(
+            "/api/conversations/{id}/messages/{messageId}/openui/{blockId}/state",
+            get(read).patch(write),
+        )
+}
+
+async fn tools(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path(id): Path<String>,
+) -> Result<Json<ApiResponse<Vec<OpenUiTool>>>, ApiError> {
+    Ok(Json(ApiResponse::ok(
+        state
+            .service
+            .openui_service()?
+            .tools(&state.service, &user.id, &id)
+            .await?,
+    )))
+}
+
+async fn call(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path(id): Path<String>,
+    body: Result<Json<OpenUiToolCall>, axum::extract::rejection::JsonRejection>,
+) -> Result<Json<ApiResponse<serde_json::Value>>, ApiError> {
+    let Json(request) = body.map_err(ApiError::from)?;
+    Ok(Json(ApiResponse::ok(
+        state
+            .service
+            .openui_service()?
+            .call_tool(&state.service, &user.id, &id, request)
+            .await?,
+    )))
+}
+
+async fn cancel(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path((id, operation)): Path<(String, String)>,
+) -> Result<Json<ApiResponse<()>>, ApiError> {
+    // Ownership is checked even when the operation already completed.
+    state.service.get(&user.id, &id).await?;
+    state
+        .service
+        .openui_service()?
+        .cancel_operation(&user.id, &id, &operation);
+    Ok(Json(ApiResponse::ok(())))
+}
+
+async fn capabilities(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+) -> Result<Json<ApiResponse<OpenUiCapabilities>>, ApiError> {
+    Ok(Json(ApiResponse::ok(
+        state.service.openui_service()?.capabilities(&user.id).await?,
+    )))
+}
+
+async fn read(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path((conversation_id, message_id, block_id)): Path<(String, String, String)>,
+) -> Result<Json<ApiResponse<OpenUiState>>, ApiError> {
+    let key = OpenUiStateKey {
+        user_id: user.id,
+        conversation_id,
+        message_id,
+        block_id,
+    };
+    Ok(Json(ApiResponse::ok(
+        state.service.openui_service()?.read_state(&key).await?,
+    )))
+}
+
+async fn write(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path((conversation_id, message_id, block_id)): Path<(String, String, String)>,
+    body: Result<Json<OpenUiState>, axum::extract::rejection::JsonRejection>,
+) -> Result<Json<ApiResponse<OpenUiState>>, ApiError> {
+    let Json(request) = body.map_err(ApiError::from)?;
+    let key = OpenUiStateKey {
+        user_id: user.id,
+        conversation_id,
+        message_id,
+        block_id,
+    };
+    Ok(Json(ApiResponse::ok(
+        state.service.openui_service()?.write_state(&key, request).await?,
+    )))
+}
