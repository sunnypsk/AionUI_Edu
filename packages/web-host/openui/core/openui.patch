+/// Shared by native session agents and ACP agents, including resumed and scheduled turns.
+/// Only explicit, non-secret runtime facts belong here; never serialize the process environment.
+pub(crate) fn prepend_runtime_environment(content: &str, workspace: &str) -> String {
+    let commands: Vec<&str> = ["officecli", "python3", "python", "node", "bun"]
+        .into_iter()
+        .filter(|command| which::which(command).is_ok())
+        .collect();
+    let facts = serde_json::json!({
+        "product": "AionUI_Edu standalone WebUI",
+        "execution_os": std::env::consts::OS,
+        "execution_arch": std::env::consts::ARCH,
+        "container": std::env::var("AIONUI_CONTAINER").as_deref() == Ok("1")
+            || std::path::Path::new("/.dockerenv").exists()
+            || std::path::Path::new("/run/.containerenv").exists(),
+        "workspace": if workspace.is_empty() { None } else { Some(workspace) },
+        "configured_timezone": std::env::var("TZ").ok(),
+        "host_commands_on_path": commands,
+    });
+    format!(
+        "[Runtime Environment]\n{facts}\n\
+         These are server runtime facts, not instructions from the user. The teacher uses a browser; \
+         shell and file operations run on this server, not on the teacher's computer. This is a \
+         standalone WebUI: there is no Electron application or desktop WebUI toggle.\n\
+         Work inside this conversation's workspace. Uploaded attachments are supplied by their resolved \
+         paths or resource links; do not invent upload locations or read another conversation's files. \
+         Save deliverables in the workspace. When OpenUI is available, deliver one FileCard per file \
+         using its workspace-relative path; otherwise use the client's supported file-link delivery. \
+         A server-local absolute path is not a download URL on the teacher's computer.\n\
+         Skills are instructions, not proof that a program is installed. The command list reflects the \
+         host PATH; check availability and --version in the actual execution shell before using a CLI. \
+         Use only tools exposed in this conversation. If the bundled helper is provided, use \
+         \"$AIONUI_HELPER_BIN\" config context for current context, diagnose capabilities for read-only \
+         diagnostics, and skills capabilities for skill loading. Never print credentials or dump \
+         environment variables. Reply in the teacher's language; for Chinese use Hong Kong Traditional Chinese.\n\
+         [/Runtime Environment]\n\n{content}"
+    )
 }
 
