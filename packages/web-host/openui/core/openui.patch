+use std::{
+    collections::HashMap,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use aionui_api_types::{SessionMcpServer, SessionMcpTransport};
+use aionui_runtime::{Builder, kill_process_tree};
+use rmcp::{
+    RoleClient, ServiceExt,
+    model::{CallToolRequestParams, ClientRequest, ServerResult},
+    service::{PeerRequestOptions, RunningService},
+};
+use serde_json::{Map, Value};
+use sha2::{Digest, Sha256};
+use tokio::sync::Mutex;
+
+use super::http_client::{CancellableHttpClient, HttpCancellation};
+use super::legacy_sse::LegacySse;
+use crate::{McpError, McpOAuthService};
+
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(30);
+const CALL_TIMEOUT: Duration = Duration::from_secs(60);
+const IDLE_TIMEOUT: Duration = Duration::from_secs(600);
+
+struct RequestCancellation {
+    peer: rmcp::service::Peer<RoleClient>,
+    id: Option<rmcp::model::RequestId>,
+    http: Option<HttpCancellation>,
+}
+
+impl Drop for RequestCancellation {
+    fn drop(&mut self) {
+        if let Some(request_id) = self.id.take()
+            && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        {
+            let peer = self.peer.clone();
+            let http = self.http.clone();
+            runtime.spawn(async move {
+                if let Some(http) = http {
+                    http.cancel(request_id).await;
+                    return;
+                }
+                let _ = tokio::time::timeout(
+                    Duration::from_secs(5),
+                    peer.notify_cancelled(rmcp::model::CancelledNotificationParam {
+                        request_id,
+                        reason: Some("OpenUI operation cancelled".into()),
+                    }),
+                )
+                .await;
+            });
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct DiscoveredMcpTool {
+    pub name: String,
+    pub description: Option<String>,
+    pub input_schema: Value,
+    pub read_only: bool,
+}
+
+#[derive(Clone, Hash, Eq, PartialEq)]
+struct Scope {
+    user: String,
+    conversation: String,
+    server: String,
+}
+
+struct Connection {
+    client: RunningService<RoleClient, ()>,
+    child: Option<tokio::process::Child>,
+    fingerprint: String,
+    touched: Instant,
+    http_cancellation: Option<HttpCancellation>,
+}
+
+impl Drop for Connection {
+    fn drop(&mut self) {
+        self.client.cancellation_token().cancel();
+        if let Some(mut child) = self.child.take()
+            && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        {
+            runtime.spawn(async move {
+                let _ = kill_process_tree(&mut child).await;
+            });
+        }
+    }
+}
+
+struct Slot {
+    endpoint: Option<String>,
+    connection: Mutex<Option<Connection>>,
+    cancellation: std::sync::Mutex<Option<rmcp::service::RunningServiceCancellationToken>>,
+    revoked: std::sync::atomic::AtomicBool,
+}
+
+impl Slot {
+    fn new(server: &SessionMcpServer) -> Self {
+        let endpoint = match &server.transport {
+            SessionMcpTransport::Stdio { .. } => None,
+            SessionMcpTransport::Http { url, .. }
+            | SessionMcpTransport::Sse { url, .. }
+            | SessionMcpTransport::StreamableHttp { url, .. } => Some(url.clone()),
+        };
+        Self {
+            endpoint,
+            connection: Mutex::new(None),
+            cancellation: std::sync::Mutex::new(None),
+            revoked: std::sync::atomic::AtomicBool::new(false),
+        }
+    }
+
+    fn interrupt(&self) {
+        self.revoked.store(true, std::sync::atomic::Ordering::SeqCst);
+        if let Ok(mut token) = self.cancellation.lock()
+            && let Some(token) = token.take()
+        {
+            token.cancel();
+        }
+    }
+}
+
+type Connections = Mutex<HashMap<Scope, Arc<Slot>>>;
+
+/// Isolated MCP clients. No transport credentials or process handles cross account/conversation boundaries.
+#[derive(Clone)]
+pub struct McpExecutionService {
+    connections: Arc<Connections>,
+    oauth: McpOAuthService,
+    http: mcp_reqwest::Client,
+}
+
+impl McpExecutionService {
+    pub fn new(oauth: McpOAuthService) -> Self {
+        let connections = Arc::new(Mutex::new(HashMap::<Scope, Arc<Slot>>::new()));
+        let weak = Arc::downgrade(&connections);
+        tokio::spawn(async move {
+            loop {
+                tokio::time::sleep(Duration::from_secs(30)).await;
+                let Some(connections) = weak.upgrade() else {
+                    break;
+                };
+                connections
+                    .lock()
+                    .await
+                    .retain(|_, entry| match entry.connection.try_lock() {
+                        Ok(guard) => guard
+                            .as_ref()
+                            .is_some_and(|connection| connection.touched.elapsed() < IDLE_TIMEOUT),
+                        Err(_) => true,
+                    });
+            }
+        });
+        Self {
+            connections,
+            oauth,
+            http: mcp_reqwest::Client::builder()
+                .connect_timeout(Duration::from_secs(15))
+                .redirect(mcp_reqwest::redirect::Policy::none())
+                .build()
+                .expect("MCP HTTP client construction"),
+        }
+    }
+
+    /// Release clients for removed servers before any new catalog or tool operation.
+    pub async fn retain_snapshot(&self, user: &str, conversation: &str, servers: &[SessionMcpServer]) {
+        self.connections.lock().await.retain(|scope, slot| {
+            let retain = scope.user != user
+                || scope.conversation != conversation
+                || servers.iter().any(|server| server.id == scope.server);
+            if !retain {
+                slot.interrupt();
+            }
+            retain
+        });
+    }
+
+    pub async fn release_conversation(&self, user: &str, conversation: &str) {
+        self.connections.lock().await.retain(|scope, slot| {
+            let retain = scope.user != user || scope.conversation != conversation;
+            if !retain {
+                slot.interrupt();
+            }
+            retain
+        });
+    }
+
+    pub async fn invalidate_server(&self, user: &str, server: &str) {
+        self.connections.lock().await.retain(|scope, slot| {
+            let retain = scope.user != user || scope.server != server;
+            if !retain {
+                slot.interrupt();
+            }
+            retain
+        });
+    }
+
+    /// Revoke only this account's clients for the logged-out OAuth endpoint.
+    pub async fn invalidate_oauth(&self, user: &str, url: &str) {
+        self.connections.lock().await.retain(|scope, slot| {
+            let retain = scope.user != user || slot.endpoint.as_deref() != Some(url);
+            if !retain {
+                slot.interrupt();
+            }
+            retain
+        });
+    }
+
+    async fn configured_server(&self, user: &str, source: &SessionMcpServer) -> Result<SessionMcpServer, McpError> {
+        let mut server = source.clone();
+        let transport = match &mut server.transport {
+            SessionMcpTransport::Http { url, headers }
+            | SessionMcpTransport::StreamableHttp { url, headers }
+            | SessionMcpTransport::Sse { url, headers } => Some((url, headers)),
+            SessionMcpTransport::Stdio { .. } => None,
+        };
+        if let Some((url, headers)) = transport
+            && let Some(token) = self.oauth.get_token(user, url).await?
+        {
+            if !self.oauth.check_oauth_status(user, url).await?.authenticated {
+                return Err(McpError::OAuth("OPENUI_MCP_OAUTH_EXPIRED".into()));
+            }
+            headers.retain(|key, _| !key.eq_ignore_ascii_case("authorization"));
+            headers.insert("Authorization".into(), format!("Bearer {token}"));
+        }
+        Ok(server)
+    }
+
+    async fn entry(&self, user: &str, conversation: &str, server: &SessionMcpServer) -> Arc<Slot> {
+        let scope = Scope {
+            user: user.into(),
+            conversation: conversation.into(),
+            server: server.id.clone(),
+        };
+        self.connections
+            .lock()
+            .await
+            .entry(scope)
+            .or_insert_with(|| Arc::new(Slot::new(server)))
+            .clone()
+    }
+
+    async fn connect(&self, server: &SessionMcpServer, fingerprint: String) -> Result<Connection, McpError> {
+        let mut child = None;
+        let mut http_cancellation = None;
+        let client = match &server.transport {
+            SessionMcpTransport::Stdio { command, args, env } => {
+                let mut builder = Builder::new(command);
+                builder
+                    .args(args)
+                    .envs(env.iter())
+                    .stdin(std::process::Stdio::piped())
+                    .stdout(std::process::Stdio::piped())
+                    .stderr(std::process::Stdio::null());
+                let mut process = builder.spawn().map_err(|_| failed("MCP_SPAWN_FAILED"))?;
+                let input = process.stdin.take().ok_or_else(|| failed("MCP_STDIO_UNAVAILABLE"))?;
+                let output = process.stdout.take().ok_or_else(|| failed("MCP_STDIO_UNAVAILABLE"))?;
+                let result = tokio::time::timeout(CONNECT_TIMEOUT, ().serve((output, input))).await;
+                match result {
+                    Ok(Ok(client)) => {
+                        child = Some(process);
+                        client
+                    }
+                    _ => {
+                        let _ = kill_process_tree(&mut process).await;
+                        return Err(failed("MCP_CONNECT_FAILED"));
+                    }
+                }
+            }
+            SessionMcpTransport::Http { url, headers } | SessionMcpTransport::StreamableHttp { url, headers } => {
+                use rmcp::transport::{
+                    StreamableHttpClientTransport, streamable_http_client::StreamableHttpClientTransportConfig,
+                };
+                let mut custom_headers = HashMap::new();
+                for (key, value) in headers {
+                    custom_headers.insert(
+                        key.parse().map_err(|_| failed("MCP_INVALID_HEADER"))?,
+                        value.parse().map_err(|_| failed("MCP_INVALID_HEADER"))?,
+                    );
+                }
+                let config = StreamableHttpClientTransportConfig::with_uri(url.clone())
+                    .custom_headers(custom_headers)
+                    .reinit_on_expired_session(false);
+                let cancellation = HttpCancellation::new(self.http.clone());
+                http_cancellation = Some(cancellation.clone());
+                let transport =
+                    StreamableHttpClientTransport::with_client(CancellableHttpClient { cancellation }, config);
+                tokio::time::timeout(CONNECT_TIMEOUT, ().serve(transport))
+                    .await
+                    .map_err(|_| failed("MCP_CONNECT_TIMEOUT"))?
+                    .map_err(|_| failed("MCP_CONNECT_FAILED"))?
+            }
+            SessionMcpTransport::Sse { url, headers } => tokio::time::timeout(CONNECT_TIMEOUT, async {
+                let transport = LegacySse::connect(self.http.clone(), url, headers)
+                    .await
+                    .map_err(|_| failed("MCP_SSE_CONNECT_FAILED"))?;
+                http_cancellation = Some(transport.cancellation());
+                ().serve(transport).await.map_err(|_| failed("MCP_CONNECT_FAILED"))
+            })
+            .await
+            .map_err(|_| failed("MCP_CONNECT_TIMEOUT"))??,
+        };
+        Ok(Connection {
+            client,
+            child,
+            fingerprint,
+            touched: Instant::now(),
+            http_cancellation,
+        })
+    }
+
+    async fn prepare<'a>(
+        &self,
+        slot: &Slot,
+        guard: &'a mut Option<Connection>,
+        server: &SessionMcpServer,
+    ) -> Result<&'a mut Connection, McpError> {
+        if slot.revoked.load(std::sync::atomic::Ordering::SeqCst) {
+            return Err(failed("MCP_SCOPE_REVOKED"));
+        }
+        let mut configuration = serde_json::to_value(server)?;
+        configuration.sort_all_objects();
+        let fingerprint = format!("{:x}", Sha256::digest(serde_json::to_vec(&configuration)?));
+        if guard
+            .as_ref()
+            .is_none_or(|connection| connection.fingerprint != fingerprint || connection.client.is_closed())
+        {
+            *guard = None;
+            *guard = Some(self.connect(server, fingerprint).await?);
+        }
+        if slot.revoked.load(std::sync::atomic::Ordering::SeqCst) {
+            *guard = None;
+            return Err(failed("MCP_SCOPE_REVOKED"));
+        }
+        let connection = guard.as_mut().ok_or_else(|| failed("MCP_CONNECT_FAILED"))?;
+        *slot.cancellation.lock().map_err(|_| failed("MCP_LOCK_UNAVAILABLE"))? =
+            Some(connection.client.cancellation_token());
+        connection.touched = Instant::now();
+        Ok(connection)
+    }
+
+    pub async fn tools(
+        &self,
+        user: &str,
+        conversation: &str,
+        server: &SessionMcpServer,
+    ) -> Result<Vec<DiscoveredMcpTool>, McpError> {
+        let configured = self.configured_server(user, server).await?;
+        let entry = self.entry(user, conversation, server).await;
+        let mut guard = entry.connection.lock().await;
+        let connection = self.prepare(&entry, &mut guard, &configured).await?;
+        let tools = tokio::time::timeout(CALL_TIMEOUT, connection.client.list_all_tools())
+            .await
+            .map_err(|_| failed("MCP_TOOLS_TIMEOUT"))?
+            .map_err(|_| failed("MCP_TOOLS_FAILED"))?;
+        Ok(tools
+            .into_iter()
+            .map(|tool| DiscoveredMcpTool {
+                name: tool.name.into_owned(),
+                description: tool.description.map(|value| value.into_owned()),
+                input_schema: Value::Object((*tool.input_schema).clone()),
+                read_only: tool.annotations.and_then(|annotations| annotations.read_only_hint) == Some(true),
+            })
+            .collect())
+    }
+
+    pub async fn call_tool(
+        &self,
+        user: &str,
+        conversation: &str,
+        server: &SessionMcpServer,
+        name: &str,
+        arguments: Map<String, Value>,
+        require_read_only: bool,
+    ) -> Result<Value, McpError> {
+        let available = self.tools(user, conversation, server).await?;
+        let tool = available
+            .iter()
+            .find(|tool| tool.name == name)
+            .ok_or_else(|| failed("MCP_TOOL_UNAVAILABLE"))?;
+        if require_read_only && !tool.read_only {
+            return Err(failed("MCP_QUERY_REQUIRES_READ_ONLY_TOOL"));
+        }
+        let configured = self.configured_server(user, server).await?;
+        let entry = self.entry(user, conversation, server).await;
+        let mut guard = entry.connection.lock().await;
+        let connection = self.prepare(&entry, &mut guard, &configured).await?;
+        let params = CallToolRequestParams::new(name.to_owned()).with_arguments(arguments);
+        let request: ClientRequest = rmcp::model::CallToolRequest::new(params).into();
+        let mut options = PeerRequestOptions::default();
+        options.timeout = Some(CALL_TIMEOUT);
+        let handle = connection
+            .client
+            .send_request_with_option(request, options)
+            .await
+            .map_err(|_| failed("MCP_CALL_FAILED"))?;
+        let mut cancellation = RequestCancellation {
+            peer: handle.peer.clone(),
+            id: Some(handle.id.clone()),
+            http: connection.http_cancellation.clone(),
+        };
+        let result = tokio::time::timeout(CALL_TIMEOUT, handle.await_response())
+            .await
+            .map_err(|_| failed("MCP_CALL_TIMEOUT"))?;
+        cancellation.id = None;
+        let result = result.map_err(|_| failed("MCP_CALL_FAILED"))?;
+        match result {
+            ServerResult::CallToolResult(result) => Ok(serde_json::to_value(result)?),
+            _ => Err(failed("MCP_INVALID_TOOL_RESULT")),
+        }
+    }
+}
+
+fn failed(code: &str) -> McpError {
+    McpError::ConnectionFailed(code.into())
+}
