+
+/// Account-scoped state and compatibility service. Original assistant messages remain immutable.
+pub struct OpenUiService {
+    pub(super) states: Arc<dyn IOpenUiRepository>,
+    conversations: Arc<dyn IConversationRepository>,
+    preferences: Arc<dyn IClientPreferenceRepository>,
+    manifest: Value,
+    pub(super) runtime: Option<super::runtime::OpenUiRuntime>,
