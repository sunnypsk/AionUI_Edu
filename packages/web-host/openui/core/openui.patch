+use std::{
+    collections::{HashMap, HashSet},
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use aionui_api_types::WebSocketMessage;
+use aionui_common::{Confirmation, ConfirmationOption};
+use aionui_realtime::EventBroadcaster;
+use serde_json::{Value, json};
+use tokio::sync::oneshot;
+
+use crate::ConversationError;
+
+struct Pending {
+    user: String,
+    conversation: String,
+    approval_key: String,
+    confirmation: Confirmation,
+    answer: oneshot::Sender<bool>,
+}
+
+struct Inner {
+    pending: Mutex<HashMap<String, Pending>>,
+    remembered: Mutex<HashSet<(String, String, String)>>,
+    broadcaster: Arc<dyn EventBroadcaster>,
+}
+
+#[derive(Clone)]
+pub(crate) struct OpenUiPermissions(Arc<Inner>);
+
+struct PendingGuard {
+    inner: Arc<Inner>,
+    user: String,
+    conversation: String,
+    id: String,
+}
+
+impl Drop for PendingGuard {
+    fn drop(&mut self) {
+        if let Ok(mut pending) = self.inner.pending.lock() {
+            pending.remove(&self.id);
+        }
+        self.inner.broadcaster.broadcast(WebSocketMessage::new(
+            "confirmation.remove",
+            json!({
+                "user_id": self.user, "conversation_id": self.conversation, "id": self.id,
+            }),
+        ));
+    }
+}
+
+impl OpenUiPermissions {
+    pub fn new(broadcaster: Arc<dyn EventBroadcaster>) -> Self {
+        Self(Arc::new(Inner {
+            pending: Mutex::new(HashMap::new()),
+            remembered: Mutex::new(HashSet::new()),
+            broadcaster,
+        }))
+    }
+
+    pub async fn request(
+        &self,
+        user: &str,
+        conversation: &str,
+        approval_key: &str,
+        title: String,
+        input: Value,
+    ) -> Result<(), ConversationError> {
+        let remembered = (user.to_owned(), conversation.to_owned(), approval_key.to_owned());
+        if self
+            .0
+            .remembered
+            .lock()
+            .map_err(|_| unavailable())?
+            .contains(&remembered)
+        {
+            return Ok(());
+        }
+        let id = aionui_common::generate_prefixed_id("openui-permission");
+        let confirmation = Confirmation {
+            id: id.clone(),
+            call_id: id.clone(),
+            title: Some(title),
+            action: Some("mcp".into()),
+            description: String::new(),
+            questions: None,
+            command_type: Some(serde_json::to_string_pretty(&input).map_err(|_| unavailable())?),
+            options: vec![
+                ConfirmationOption {
+                    label: "messages.confirmation.yesAllowOnce".into(),
+                    value: json!("allow_once"),
+                    params: None,
+                },
+                ConfirmationOption {
+                    label: "messages.confirmation.yesAllowAlways".into(),
+                    value: json!("allow_always"),
+                    params: None,
+                },
+                ConfirmationOption {
+                    label: "messages.confirmation.no".into(),
+                    value: json!("reject_once"),
+                    params: None,
+                },
+            ],
+        };
+        let (sender, receiver) = oneshot::channel();
+        {
+            let mut pending = self.0.pending.lock().map_err(|_| unavailable())?;
+            if pending
+                .values()
+                .filter(|item| item.user == user && item.conversation == conversation)
+                .count()
+                >= 8
+            {
+                return Err(ConversationError::RateLimited);
+            }
+            pending.insert(
+                id.clone(),
+                Pending {
+                    user: user.into(),
+                    conversation: conversation.into(),
+                    approval_key: approval_key.into(),
+                    confirmation: confirmation.clone(),
+                    answer: sender,
+                },
+            );
+        }
+        let _guard = PendingGuard {
+            inner: self.0.clone(),
+            user: user.into(),
+            conversation: conversation.into(),
+            id: id.clone(),
+        };
+        self.0.broadcaster.broadcast(WebSocketMessage::new(
+            "message.stream",
+            json!({
+                "user_id": user, "conversation_id": conversation, "msg_id": id,
+                "type": "openui_permission", "data": confirmation, "hidden": false,
+            }),
+        ));
+        match tokio::time::timeout(Duration::from_secs(120), receiver).await {
+            Ok(Ok(true)) => Ok(()),
+            _ => Err(ConversationError::Forbidden {
+                reason: "OPENUI_PERMISSION_DENIED".into(),
+            }),
+        }
+    }
+
+    pub fn list(&self, user: &str, conversation: &str) -> Vec<Confirmation> {
+        self.0
+            .pending
+            .lock()
+            .map(|pending| {
+                pending
+                    .values()
+                    .filter(|item| item.user == user && item.conversation == conversation)
+                    .map(|item| item.confirmation.clone())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    pub fn confirm(
+        &self,
+        user: &str,
+        conversation: &str,
+        id: &str,
+        data: &Value,
+        always_allow: bool,
+    ) -> Result<bool, ConversationError> {
+        let picked = data.as_str().or_else(|| {
+            data.get("option_id")
+                .or_else(|| data.get("optionId"))
+                .or_else(|| data.get("value"))
+                .and_then(Value::as_str)
+        });
+        if !matches!(
+            picked,
+            Some("allow" | "allow_once" | "allow_always" | "reject" | "reject_once")
+        ) {
+            return Err(ConversationError::BadRequest {
+                reason: "OPENUI_INVALID_PERMISSION_RESPONSE".into(),
+            });
+        }
+        let mut pending = self.0.pending.lock().map_err(|_| unavailable())?;
+        if !pending
+            .get(id)
+            .is_some_and(|item| item.user == user && item.conversation == conversation)
+        {
+            return Ok(false);
+        }
+        let item = pending.remove(id).ok_or_else(unavailable)?;
+        let approved = !matches!(picked, Some("reject" | "reject_once"));
+        if approved && (always_allow || picked == Some("allow_always")) {
+            self.0.remembered.lock().map_err(|_| unavailable())?.insert((
+                user.into(),
+                conversation.into(),
+                item.approval_key,
+            ));
+        }
+        let _ = item.answer.send(approved);
+        Ok(true)
+    }
+
+    pub fn release(&self, user: &str, conversation: &str) {
+        if let Ok(mut pending) = self.0.pending.lock() {
+            pending.retain(|_, item| item.user != user || item.conversation != conversation);
+        }
+        if let Ok(mut remembered) = self.0.remembered.lock() {
+            remembered.retain(|item| item.0 != user || item.1 != conversation);
+        }
+    }
+}
+
+fn unavailable() -> ConversationError {
+    ConversationError::internal("OPENUI_PERMISSION_SERVICE_UNAVAILABLE")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use aionui_realtime::BroadcastEventBus;
