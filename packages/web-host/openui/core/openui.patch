+#[tokio::test]
+async fn two_devices_cannot_silently_overwrite_each_other() {
+    let (_db, repository, _conversations, key) = setup().await;
+    repository.save(&key, &state(0, "{}")).await.unwrap();
+    let first = state(1, r#"{"name":"first"}"#);
+    let second = state(1, r#"{"name":"second"}"#);
+    let (one, two) = tokio::join!(repository.save(&key, &first), repository.save(&key, &second));
+    assert_eq!(usize::from(one.is_ok()) + usize::from(two.is_ok()), 1);
+    let error = one.err().or_else(|| two.err()).unwrap();
+    assert!(matches!(error, DbError::Conflict(message) if message == "OPENUI_STATE_REVISION_CONFLICT"));
+    assert_eq!(repository.get(&key).await.unwrap().unwrap().revision, 2);
+}
+
+#[tokio::test]
+async fn simultaneous_first_edits_have_one_winner() {
+    let (_db, repository, _conversations, key) = setup().await;
+    let initial = state(0, "{}");
+    let (one, two) = tokio::join!(repository.save(&key, &initial), repository.save(&key, &initial));
+    assert_eq!(usize::from(one.is_ok()) + usize::from(two.is_ok()), 1);
