+    pub(crate) fn pending_confirmations(&self, user: &str, conversation: &str) -> Vec<aionui_common::Confirmation> {
+        self.runtime
+            .as_ref()
+            .map(|runtime| runtime.permissions.list(user, conversation))
+            .unwrap_or_default()
+    }
+
+    pub(crate) fn confirm_pending(
+        &self,
+        user: &str,
+        conversation: &str,
+        id: &str,
+        data: &Value,
+        always_allow: bool,
+    ) -> Result<bool, ConversationError> {
+        let Some(runtime) = &self.runtime else {
+            return Ok(false);
+        };
+        if !runtime
+            .permissions
+            .list(user, conversation)
+            .iter()
+            .any(|item| item.call_id == id)
+        {
+            return Ok(false);
+        }
+        runtime.permissions.confirm(user, conversation, id, data, always_allow)
+    }
+
+    pub(crate) async fn release_conversation(&self, user: &str, conversation: &str) {
+        if let Some(runtime) = &self.runtime {
+            runtime.operations.release(user, conversation);
+            runtime.permissions.release(user, conversation);
+            runtime.execution.release_conversation(user, conversation).await;
+        }
+    }
+
+    pub async fn generation_enabled(&self, user_id: &str) -> Result<bool, ConversationError> {
+        let preferences = self.preferences.get_by_keys(user_id, &["openuiEnabled"]).await?;
+        Ok(!preferences
+            .iter()
+            .any(|item| item.key == "openuiEnabled" && item.value == "false"))
+    }
