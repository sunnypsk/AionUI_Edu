+const USER: &str = "system_default_user";
+
+async fn setup() -> (
+    Database,
+    SqliteOpenUiRepository,
+    SqliteConversationRepository,
+    OpenUiStateKey,
+) {
+    let db = init_database_memory().await.unwrap();
+    for id in ["conversation", "fork"] {
+        sqlx::query("INSERT INTO conversations (id,user_id,name,type,extra,created_at,updated_at) VALUES (?,?,'OpenUI','acp','{}',1,1)")
+            .bind(id).bind(USER).execute(db.pool()).await.unwrap();
+    }
+    let conversations = SqliteConversationRepository::new(db.pool().clone());
+    conversations
+        .insert_message(USER, &message("message", 1))
+        .await
+        .unwrap();
+    let repository = SqliteOpenUiRepository::new(db.pool().clone());
+    let key = OpenUiStateKey {
+        user_id: USER.into(),
+        conversation_id: "conversation".into(),
+        message_id: "message".into(),
+        block_id: "0".into(),
+    };
+    (db, repository, conversations, key)
+}
+
+fn message(id: &str, created_at: i64) -> MessageRow {
+    MessageRow {
+        id: id.into(),
+        conversation_id: "conversation".into(),
+        msg_id: Some(format!("source-{id}")),
+        r#type: "text".into(),
+        content: r#"{"content":"```openui\nroot = Text(\"Hello\");\n```"}"#.into(),
+        position: Some("left".into()),
