#!/usr/bin/env node
import { fileURLToPath } from 'node:url';

// Resolve source assets from this immutable entry, not from the bundled module.
process.env.AIONUI_CODEX_RUNTIME_DIR = fileURLToPath(new URL('.', import.meta.url));
try {
  const { launchCodex } = await import(new URL('../../../../../dist-server/codex/launcher.mjs', import.meta.url));
  process.exitCode = await launchCodex();
} catch (error) {
  const code = error?.code === 'EAGAIN' ? 'CODEX_RESOURCES_UNAVAILABLE' : 'CODEX_LAUNCH_FAILED';
  let tasks;
  if (code === 'CODEX_RESOURCES_UNAVAILABLE') {
    try {
      const { readCgroupTasks } = await import(new URL('../../../../../dist-server/codex/launcher.mjs', import.meta.url));
      tasks = await readCgroupTasks();
    } catch {
      // Diagnostics must never replace the original launch failure.
    }
  }
  console.error(JSON.stringify({ event: 'codex.launchFailed', code, ...(tasks ? { tasks } : {}) }));
  process.exitCode = 1;
}
